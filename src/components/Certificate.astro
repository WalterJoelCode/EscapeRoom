<dialog id="certificate-dialog" class="certificate-dialog" aria-labelledby="certificate-title">
  <div class="certificate-head"><div><p class="eyebrow">Vista previa temporal</p><h2 id="certificate-title">Certificado de finalización</h2></div><button id="certificate-close" class="icon-button" type="button" aria-label="Cerrar certificado">×</button></div>
  <div class="certificate-preview"><iframe id="certificate-frame" title="Vista previa del certificado PDF"></iframe></div>
  <div class="certificate-actions"><p>Modo de prueba activo. Luego este acceso se habilitará únicamente al completar las 9 misiones.</p><button id="certificate-download" class="button" type="button">Descargar PDF</button></div>
</dialog>
<script>
  import { jsPDF } from 'jspdf';
  type Badge={xp:number;name:string;icon:'bolt'|'shield'|'star'|'network'|'crown'};const badgeData:Badge[]=[{xp:500,name:'Enlace activo',icon:'bolt'},{xp:1000,name:'Guardián LAN',icon:'shield'},{xp:2000,name:'Núcleo seguro',icon:'star'},{xp:3500,name:'Arquitecto NEXO',icon:'network'},{xp:5000,name:'Maestro de red',icon:'crown'}];
  const dialog=document.querySelector<HTMLDialogElement>('#certificate-dialog')!,frame=document.querySelector<HTMLIFrameElement>('#certificate-frame')!;let pdfUrl='';const safe=(value:string,fallback:string)=>value.trim()||fallback;
  function drawLogo(doc:jsPDF,x:number,y:number,s=1){const points=[[x,y-8*s],[x+7*s,y-4*s],[x+7*s,y+4*s],[x,y+8*s],[x-7*s,y+4*s],[x-7*s,y-4*s]];doc.setDrawColor(67,215,255);doc.setLineWidth(.7*s);points.forEach((point,index)=>{const next=points[(index+1)%points.length];doc.line(point[0],point[1],next[0],next[1])});doc.setDrawColor(62,230,162);doc.setLineWidth(1.3*s);doc.line(x-4.5*s,y-3*s,x-4.5*s,y+4*s);doc.line(x-4.5*s,y-3*s,x,y+1.5*s);doc.line(x,y+1.5*s,x+4.5*s,y-3*s);doc.line(x+4.5*s,y-3*s,x+4.5*s,y+4*s);doc.setFillColor(251,191,36);doc.circle(x,y+1.5*s,1.4*s,'F')}
  function drawStatIcon(doc:jsPDF,type:'xp'|'missions'|'badges',x:number,y:number){doc.setDrawColor(67,215,255);doc.setLineWidth(.7);if(type==='xp'){doc.line(x-2,y-4,x+1,y-1);doc.line(x+1,y-1,x-1,y);doc.line(x-1,y,x+2,y+4);doc.line(x+2,y+4,x+4,y-2)}else if(type==='missions'){doc.rect(x-4,y-4,8,8,'S');doc.line(x-2,y,x-.5,y+1.5);doc.line(x-.5,y+1.5,x+2.5,y-2)}else{doc.circle(x,y,4,'S');doc.line(x-2,y+3,x-3,y+6);doc.line(x+2,y+3,x+3,y+6);doc.circle(x,y,1.4,'S')}}
  function drawBadgeIcon(doc:jsPDF,badge:Badge,x:number,y:number){doc.setFillColor(10,32,55);doc.setDrawColor(62,230,162);doc.setLineWidth(.55);doc.circle(x,y,7,'FD');switch(badge.icon){case'bolt':doc.line(x-1,y-4,x-3,y+1);doc.line(x-3,y+1,x,y+1);doc.line(x,y+1,x-1,y+5);doc.line(x-1,y+5,x+4,y-1);doc.line(x+4,y-1,x+1,y-1);doc.line(x+1,y-1,x+2,y-4);break;case'shield':doc.lines([[4,2],[0,4],[-4,-2],[0,-5],[4,-2]],x-4,y-3,[1,1],'S',true);doc.line(x-2,y,x-.5,y+2);doc.line(x-.5,y+2,x+3,y-2);break;case'star':{const pts=[] as number[][];for(let i=0;i<10;i++){const a=-Math.PI/2+i*Math.PI/5,r=i%2?2.2:5;pts.push([x+Math.cos(a)*r,y+Math.sin(a)*r])}for(let i=0;i<pts.length;i++)doc.line(pts[i][0],pts[i][1],pts[(i+1)%pts.length][0],pts[(i+1)%pts.length][1]);break}case'network':doc.circle(x,y-3,1.5,'S');doc.circle(x-4,y+3,1.5,'S');doc.circle(x+4,y+3,1.5,'S');doc.line(x,y-1.5,x-4,y+1.5);doc.line(x,y-1.5,x+4,y+1.5);doc.line(x-2.5,y+3,x+2.5,y+3);break;case'crown':doc.line(x-5,y-3,x-3,y+3);doc.line(x-3,y+3,x+3,y+3);doc.line(x+3,y+3,x+5,y-3);doc.line(x+5,y-3,x+1.5,y);doc.line(x+1.5,y,x,y-4);doc.line(x,y-4,x-1.5,y);doc.line(x-1.5,y,x-5,y-3);break}}
  function buildCertificate(){const progress=JSON.parse(localStorage.getItem('mision-conectar-progress-v2')||'{"completed":{},"totalXp":0}'),xp=Number(progress.totalXp||0),completed=Object.keys(progress.completed||{}).length,fullName=safe(localStorage.getItem('mc-agent-full-name')||'','Agente en entrenamiento'),alias=safe(localStorage.getItem('mc-agent-alias')||'','Agente'),unlocked=badgeData.filter(b=>xp>=b.xp),date=new Intl.DateTimeFormat('es',{dateStyle:'long'}).format(new Date()),doc=new jsPDF({orientation:'landscape',unit:'mm',format:'letter',compress:true}),W=279.4,H=215.9;
    doc.setProperties({title:`Certificado Misión Conectar - ${fullName}`,subject:'Certificado de finalización de misiones',author:'Misión Conectar',creator:'Misión Conectar'});doc.setFillColor(7,20,38);doc.rect(0,0,W,H,'F');doc.setDrawColor(67,215,255);doc.setLineWidth(1);doc.roundedRect(8,8,W-16,H-16,4,4,'S');doc.setDrawColor(62,230,162);doc.setLineWidth(.35);doc.roundedRect(11,11,W-22,H-22,3,3,'S');
    drawLogo(doc,28,27,1.15);doc.setTextColor(67,215,255);doc.setFont('helvetica','bold');doc.setFontSize(11);doc.text('MISIÓN CONECTAR',41,25);doc.setTextColor(152,173,192);doc.setFont('helvetica','normal');doc.setFontSize(7);doc.text('PROTOCOLO NEXO - FORMACIÓN EN INFRAESTRUCTURA DE REDES',41,30);doc.setTextColor(237,248,255);doc.setFont('helvetica','bold');doc.setFontSize(25);doc.text('CERTIFICADO DE FINALIZACIÓN',W/2,55,{align:'center'});doc.setDrawColor(67,215,255);doc.line(85,62,W-85,62);doc.setFont('helvetica','normal');doc.setTextColor(152,173,192);doc.setFontSize(10);doc.text('Se reconoce a',W/2,74,{align:'center'});doc.setTextColor(237,248,255);doc.setFont('helvetica','bold');doc.setFontSize(24);doc.text(fullName,W/2,89,{align:'center',maxWidth:220});doc.setTextColor(67,215,255);doc.setFontSize(10);doc.text(`ALIAS: ${alias.toUpperCase()}`,W/2,98,{align:'center'});doc.setTextColor(190,211,224);doc.setFont('helvetica','normal');doc.setFontSize(9);doc.text(`por completar ${completed} de 9 misiones del programa Misión Conectar y demostrar competencias`,W/2,110,{align:'center'});doc.text('en conectividad, direccionamiento, seguridad, cableado y resiliencia de redes.',W/2,116,{align:'center'});
    const cards=[{x:45,type:'xp' as const,value:xp.toLocaleString('es'),label:'XP ACUMULADOS'},{x:111,type:'missions' as const,value:`${completed}/9`,label:'MISIONES SUPERADAS'},{x:177,type:'badges' as const,value:String(unlocked.length),label:'INSIGNIAS OBTENIDAS'}];cards.forEach(card=>{doc.setFillColor(10,32,55);doc.roundedRect(card.x,126,57,28,3,3,'F');drawStatIcon(doc,card.type,card.x+12,140);doc.setTextColor(67,215,255);doc.setFont('helvetica','bold');doc.setFontSize(15);doc.text(card.value,card.x+25,138);doc.setTextColor(152,173,192);doc.setFontSize(5.8);doc.text(card.label,card.x+25,145)});
    doc.setTextColor(152,173,192);doc.setFontSize(6.5);doc.text('INSIGNIAS OBTENIDAS',W/2,164,{align:'center'});if(unlocked.length){const gap=35,start=W/2-(unlocked.length-1)*gap/2;unlocked.forEach((badge,index)=>{const x=start+index*gap;drawBadgeIcon(doc,badge,x,176);doc.setTextColor(62,230,162);doc.setFont('helvetica','bold');doc.setFontSize(5.5);doc.text(badge.name,x,188,{align:'center',maxWidth:30})})}else{doc.setTextColor(111,135,155);doc.setFontSize(7);doc.text('Aún no hay insignias desbloqueadas',W/2,177,{align:'center'})}doc.setTextColor(111,135,155);doc.setFont('helvetica','normal');doc.setFontSize(7);doc.text(`Emitido el ${date}`,24,201);doc.text('Validación local - ID '+simpleId(fullName,alias,xp,completed),W-24,201,{align:'right'});return doc}
  function simpleId(name:string,alias:string,xp:number,completed:number){let hash=2166136261;for(const char of `${name}|${alias}|${xp}|${completed}`){hash^=char.charCodeAt(0);hash=Math.imul(hash,16777619)}return Math.abs(hash>>>0).toString(36).toUpperCase().padStart(7,'0')}
  function openCertificate(){const doc=buildCertificate();if(pdfUrl)URL.revokeObjectURL(pdfUrl);pdfUrl=URL.createObjectURL(doc.output('blob'));frame.src=pdfUrl;dialog.showModal();document.dispatchEvent(new CustomEvent('mc-sound',{detail:'certificate'}))}document.addEventListener('preview-certificate',openCertificate);document.querySelector('#certificate-close')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});document.querySelector('#certificate-download')?.addEventListener('click',()=>{const fullName=safe(localStorage.getItem('mc-agent-full-name')||'','agente').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');buildCertificate().save(`certificado-mision-conectar-${fullName}.pdf`);document.dispatchEvent(new CustomEvent('mc-sound',{detail:'complete'}))});
</script>
