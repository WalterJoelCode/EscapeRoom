---
import SectionHeader from '../landing/SectionHeader.astro';
import { missions } from '../../data/missions';
---
<section id="jugar" class="section mission-section">
  <div class="site-container">
    <SectionHeader eyebrow="Centro de operaciones" title="Elige una misión y entra en la red" description="Cada reto guarda tu mejor puntuación en este dispositivo. Usa las pistas cuando una evidencia te bloquee." />
    <div class="game-layout mt-12">
      <aside class="mission-picker" aria-label="Selector de misión">
        <div class="mission-console"><span>CONSOLA DE MISIONES</span><p id="mission-console-message">Selecciona una operación para revisar su briefing.</p></div>
        <div class="picker-list">{missions.map((mission, index) => <button class:list={['mission-pick', index === 0 && 'active']} data-pick-mission={mission.code}><span>{mission.icon}</span><div><small>{mission.level} · MISIÓN {mission.code}</small><strong>{mission.title}</strong></div><b>+{mission.xp}</b></button>)}</div>
      </aside>
      <div class="game-shell" data-missions={JSON.stringify(missions)}>
        <div class="game-topbar"><div><span class="live-dot"></span><strong id="game-mission-label">MISIÓN 01 · LISTA</strong></div><div class="game-counters"><span>PISTA <b id="hints-count">0/3</b></span><span>XP <b id="game-score">0</b></span><span>◷ <b id="timer">08:00</b></span></div></div>
        <div class="game-progress"><i id="game-progress-bar"></i><span id="xp-spark" aria-hidden="true">✦</span></div>
        <div id="game-start" class="game-stage text-center"><div id="mission-seal" class="mission-seal">⚡</div><p id="mission-level" class="eyebrow">Nivel inicial</p><h3 id="mission-title">Rescata la Red</h3><p id="mission-briefing"></p><button id="start-game" class="button mt-8">Iniciar misión</button></div>
        <div id="game-question" class="game-stage hidden"><div class="flex items-center justify-between gap-4"><p id="question-step" class="eyebrow"></p><span id="question-points" class="points-chip">+100 XP</span></div><h3 id="question-text" class="question-title"></h3><div id="answers" class="mt-7 grid gap-3"></div><div id="feedback" class="feedback hidden" role="status" aria-live="polite"></div><div id="hint" class="hint-box hidden" aria-live="polite"></div><div class="mt-7 flex flex-wrap justify-between gap-3"><button id="use-hint" class="button-secondary">Solicitar pista</button><button id="next-question" class="button hidden">Siguiente prueba →</button></div></div>
        <div id="game-result" class="game-stage hidden text-center"><div class="mission-seal success">✓</div><p class="eyebrow">Misión completada</p><h3>¡Red asegurada, agente!</h3><p id="result-copy"></p><div class="result-score"><strong id="final-score">0</strong><span>XP OBTENIDOS</span></div><div class="badge-award"><span id="award-icon">⚡</span><div><small>EVIDENCIA RECUPERADA</small><strong id="award-name">Primer enlace</strong></div></div><section class="mission-debrief" aria-labelledby="debrief-title"><div class="debrief-heading"><div><p class="eyebrow">Informe posterior</p><h4 id="debrief-title">Resumen de la operación</h4></div><span id="debrief-performance">ANALIZANDO</span></div><div class="debrief-metrics"><div><span>✓</span><strong id="debrief-correct">0/3</strong><small>Decisiones correctas</small></div><div><span>×</span><strong id="debrief-errors">0</strong><small>Errores conceptuales</small></div><div><span>?</span><strong id="debrief-hints">0</strong><small>Pistas utilizadas</small></div><div><span>−</span><strong id="debrief-cost">0 XP</strong><small>Coste de ayudas</small></div></div><div class="debrief-learning"><div><small>EVIDENCIA DESBLOQUEADA</small><p id="debrief-evidence"></p></div><div><small>RECOMENDACIÓN DE PRÁCTICA</small><p id="debrief-practice"></p></div></div></section><div class="result-actions"><button id="play-again" class="button-secondary">Repetir</button><button id="next-mission" class="button">Siguiente misión →</button></div></div>
        <div id="confetti" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>
<script>
  type Question = { prompt:string; options:string[]; answer:number; hint:string; explain:string };
  type Mission = { title:string; code:string; level:string; duration:string; icon:string; xp:number; briefing:string; questions:Question[] };
  const shell = document.querySelector<HTMLElement>('.game-shell')!;
  const missions: Mission[] = JSON.parse(shell.dataset.missions || '[]');
  const key = 'mision-conectar-progress-v2';
  let missionIndex = 0, current = 0, score = 0, hintLevel = 0, seconds = 480, timerId = 0, answered = false, correctCount = 0, errorCount = 0, hintsUsed = 0, hintXpCost = 0;
  const $ = <T extends Element>(s:string) => document.querySelector<T>(s)!;
  const start = $('#game-start'), stage = $('#game-question'), result = $('#game-result');
  const hide = (el:Element, value:boolean) => el.classList.toggle('hidden', value);
  const currentMission = () => missions[missionIndex];
  const saved = () => { try { return JSON.parse(localStorage.getItem(key) || '{"completed":{},"totalXp":0}'); } catch { return { completed:{}, totalXp:0 }; } };
  function selectMission(code:string) {
    const found = missions.findIndex(m => m.code === code); if (found < 0) return; missionIndex = found;
    clearInterval(timerId); const m = currentMission(); current = 0; score = 0; hintLevel = 0; correctCount=0;errorCount=0;hintsUsed=0;hintXpCost=0;seconds = parseInt(m.duration) * 60;
    $('#mission-seal').textContent = m.icon; $('#mission-level').textContent = `Nivel ${m.level}`; $('#mission-title').textContent = m.title; $('#mission-briefing').textContent = m.briefing;
    const best=Number(saved().completed?.[m.code]||0);$('#game-mission-label').textContent = `MISIÓN ${m.code} · ${best?'COMPLETADA':'LISTA'}`; $('#timer').textContent = `${String(parseInt(m.duration)).padStart(2,'0')}:00`; $('#mission-console-message').textContent = best?`Misión completada · Mejor marca: ${best.toLocaleString('es')} XP. ${m.briefing}`:m.briefing;
    document.querySelectorAll<HTMLElement>('[data-pick-mission]').forEach(b => b.classList.toggle('active', b.dataset.pickMission === code));
    document.querySelectorAll<HTMLElement>('[data-mission-card]').forEach(c => c.classList.toggle('mission-featured', c.dataset.missionCard === code));
    hide(start,false); hide(stage,true); hide(result,true); update();
  }
  function update() {
    const m = currentMission(); $('#game-score').textContent = String(score); $('#hints-count').textContent = `${hintLevel}/3`;
    ($('#game-progress-bar') as HTMLElement).style.width = `${(current / m.questions.length) * 100}%`;
  }
  function render() {
    answered = false;hintLevel=0; const m = currentMission(), q = m.questions[current]; $('#game-mission-label').textContent = `MISIÓN ${m.code} · EN CURSO`;
    $('#question-step').textContent = `PRUEBA ${current + 1} DE ${m.questions.length}`; $('#question-points').textContent = `+${Math.round(m.xp / m.questions.length)} XP`; $('#question-text').textContent = q.prompt;
    hide($('#feedback'),true); hide($('#hint'),true); hide($('#next-question'),true); hide($('#use-hint'),false);$('#use-hint').textContent='Pista 1 · orientación (-15 XP)';
    const answers = $('#answers'); answers.innerHTML = ''; q.options.forEach((option,index) => { const b=document.createElement('button'); b.className='answer-button'; b.innerHTML=`<span>${String.fromCharCode(65+index)}</span>${option}`; b.addEventListener('click',()=>answer(index)); answers.appendChild(b); }); update();
  }
  function sparkle() { const spark=$('#xp-spark'); spark.classList.remove('burst'); void (spark as HTMLElement).offsetWidth; spark.classList.add('burst'); }
  function answer(index:number) {
    if(answered)return; answered=true; const m=currentMission(), q=m.questions[current], correct=index===q.answer, gain=correct?Math.round(m.xp/m.questions.length):25; score+=gain;if(correct)correctCount++;else errorCount++;
    document.querySelectorAll<HTMLButtonElement>('.answer-button').forEach((b,i)=>{b.disabled=true;if(i===q.answer)b.classList.add('correct');else if(i===index)b.classList.add('wrong')});
    const fb=$('#feedback'); fb.innerHTML=`<strong>${correct?'✓ Evidencia validada':'× Respuesta incorrecta'} · +${gain} XP</strong><p>${q.explain}</p>`; fb.classList.toggle('success',correct); hide(fb,false); hide($('#next-question'),false); sparkle(); update();
  }
  function tick(){seconds--;$('#timer').textContent=`${String(Math.floor(seconds/60)).padStart(2,'0')}:${String(seconds%60).padStart(2,'0')}`;if(seconds<=0)finish()}
  function begin(){const m=currentMission();current=0;score=0;hintLevel=0;correctCount=0;errorCount=0;hintsUsed=0;hintXpCost=0;seconds=parseInt(m.duration)*60;hide(start,true);hide(result,true);hide(stage,false);clearInterval(timerId);timerId=window.setInterval(tick,1000);render()}
  function celebrate(){const box=$('#confetti');box.innerHTML='';for(let i=0;i<28;i++){const s=document.createElement('i');s.style.setProperty('--x',`${Math.random()*100}%`);s.style.setProperty('--d',`${Math.random()*.8}s`);s.style.setProperty('--h',`${Math.random()*280}deg`);box.appendChild(s)}setTimeout(()=>box.innerHTML='',2600)}
  function paintCompletedMissions(){const completed=saved().completed||{};document.querySelectorAll<HTMLElement>('[data-pick-mission]').forEach(button=>{const best=Number(completed[button.dataset.pickMission!]||0),status=button.querySelector<HTMLElement>('b')!;button.classList.toggle('is-completed',best>0);button.setAttribute('aria-label',best?`${button.querySelector('strong')?.textContent}, completada con ${best} XP`:`${button.querySelector('strong')?.textContent}, pendiente`);status.textContent=best?'✓ HECHA':`+${missions.find(m=>m.code===button.dataset.pickMission)?.xp||0}`;status.title=best?`Mejor marca: ${best.toLocaleString('es')} XP`:'XP disponibles'})}
  function finish(){clearInterval(timerId);const m=currentMission();score+=Math.max(0,Math.floor(seconds/30));const data=saved();const old=Number(data.completed[m.code]||0);data.completed[m.code]=Math.max(old,score);data.totalXp=Object.values(data.completed).reduce((a,v)=>Number(a)+Number(v),0);localStorage.setItem(key,JSON.stringify(data));const completed=Object.keys(data.completed).length,reveals:Record<number,string>={2:'Origen de acceso identificado: 185.199.110.153.',4:'Técnica inicial confirmada: credencial filtrada.',6:'Infraestructura localizada: VPS y túnel cifrado.',8:'Alias operativo recuperado: NULL-RAVEN.',9:'Identidad y cadena completa del ataque reconstruidas.'},practice:Record<string,string>={'01':'Repasa diagnóstico por capas: físico, conectividad IP y DNS.','02':'Practica red, rango de hosts y broadcast con prefijos /24.','03':'Repite rutas, gateways y lectura de saltos con tracert.','04':'Refuerza fuerza bruta, MFA y mínimo privilegio.','05':'Diseña segmentación con VLAN y enlaces trunk.','06':'Compara medios, conectores y límites de distancia Ethernet.','07':'Practica ACL específicas y separación mediante DMZ.','08':'Repasa contención, preservación de logs e integridad con hashes.','09':'Diseña redundancia con STP, VRRP y restauraciones verificadas.'},evidence=reveals[completed]||`Registro técnico de ${m.title} incorporado al caso NEXO-0213.`;paintCompletedMissions();hide(stage,true);hide(result,false);($('#game-progress-bar') as HTMLElement).style.width='100%';$('#final-score').textContent=String(score);$('#result-copy').textContent=`Completaste ${m.title}. ${evidence}`;$('#award-icon').textContent=m.icon;$('#award-name').textContent=m.title;$('#debrief-correct').textContent=`${correctCount}/${m.questions.length}`;$('#debrief-errors').textContent=String(errorCount);$('#debrief-hints').textContent=String(hintsUsed);$('#debrief-cost').textContent=`${hintXpCost} XP`;$('#debrief-evidence').textContent=evidence;$('#debrief-practice').textContent=errorCount||hintsUsed?practice[m.code]:'Dominio sólido. Puedes continuar con la siguiente evidencia.';$('#debrief-performance').textContent=errorCount===0&&hintsUsed===0?'OPERACIÓN PERFECTA':errorCount<=1?'EVIDENCIA VALIDADA':'REQUIERE REFUERZO';$('#next-mission').classList.toggle('hidden',missionIndex===missions.length-1);celebrate();document.dispatchEvent(new CustomEvent('mission-complete',{detail:{totalXp:data.totalXp,completed}}))}
  document.querySelectorAll<HTMLElement>('[data-pick-mission]').forEach(b=>b.addEventListener('click',()=>selectMission(b.dataset.pickMission!)));
  document.querySelectorAll<HTMLElement>('[data-play-mission]').forEach(b=>b.addEventListener('click',()=>selectMission(b.dataset.playMission!)));
  document.querySelectorAll<HTMLElement>('[data-mission-card]').forEach(card=>{const open=()=>{selectMission(card.dataset.missionCard!);document.querySelector('#jugar')?.scrollIntoView({behavior:'smooth'})};card.addEventListener('click',(event)=>{if((event.target as HTMLElement).closest('a'))return;open()});card.addEventListener('keydown',(event)=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();open()}})});
  $('#start-game').addEventListener('click',begin);$('#play-again').addEventListener('click',begin);$('#next-mission').addEventListener('click',()=>selectMission(missions[Math.min(missionIndex+1,missions.length-1)].code));
  $('#use-hint').addEventListener('click',()=>{if(answered||hintLevel>=3)return;hintLevel++;const q=currentMission().questions[current],cost=[0,15,30,50][hintLevel];hintsUsed++;hintXpCost+=cost;score=Math.max(0,score-cost);const hint=$('#hint'),buttons=[...document.querySelectorAll<HTMLButtonElement>('.answer-button')];if(hintLevel===1)hint.innerHTML=`<strong>PISTA 1 · ORIENTACIÓN</strong><p>${q.hint}</p>`;if(hintLevel===2){const removable=buttons.map((button,index)=>({button,index})).filter(item=>item.index!==q.answer).slice(0,2);removable.forEach(item=>{item.button.disabled=true;item.button.classList.add('eliminated')});hint.innerHTML=`<strong>PISTA 2 · DESCARTE</strong><p>Dos opciones incompatibles con la evidencia han sido desactivadas. Compara las restantes.</p>`}if(hintLevel===3)hint.innerHTML=`<strong>PISTA 3 · EXPLICACIÓN GUIADA</strong><p>La evidencia apunta a <b>${q.options[q.answer]}</b>: ${q.explain}</p>`;hide(hint,false);const nextLabels=['','Pista 2 · descartar (-30 XP)','Pista 3 · explicación (-50 XP)','Pistas agotadas'];$('#use-hint').textContent=nextLabels[hintLevel];if(hintLevel===3)hide($('#use-hint'),true);document.dispatchEvent(new CustomEvent('mc-sound',{detail:'alert'}));update()});
  $('#next-question').addEventListener('click',()=>{current++;current>=currentMission().questions.length?finish():render()});
  const requestedMission=new URLSearchParams(location.search).get('mision');document.addEventListener('progress-reset',paintCompletedMissions);paintCompletedMissions();selectMission(requestedMission&&missions.some(m=>m.code===requestedMission)?requestedMission:'01');
</script>
