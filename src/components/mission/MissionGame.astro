---
import SectionHeader from '../landing/SectionHeader.astro';
import { questions } from '../../data/missions';
---
<section id="jugar" class="section mission-section">
	<div class="site-container"><SectionHeader eyebrow="Misión funcional" title="Detective IP: localiza al intruso" description="Analiza cinco evidencias. Dispones de dos pistas y 12 minutos para cerrar el caso." />
	<div class="game-shell mt-12" data-questions={JSON.stringify(questions)}>
		<div class="game-topbar"><div><span class="live-dot"></span><strong>MISIÓN 02 · EN CURSO</strong></div><div class="game-counters"><span>PISTAS <b id="hints-count">2</b></span><span>XP <b id="game-score">0</b></span><span aria-label="Tiempo restante">◷ <b id="timer">12:00</b></span></div></div>
		<div class="game-progress"><i id="game-progress-bar"></i></div>
		<div id="game-start" class="game-stage text-center"><div class="mission-seal">⌖</div><h3>Expediente #192.168</h3><p>Un dispositivo desconocido apareció en la red del laboratorio. Interpreta las evidencias de direccionamiento y descubre dónde se esconde.</p><button id="start-game" class="button mt-8">Abrir expediente</button><button id="reset-game" class="text-button mt-5 hidden">Reiniciar avance guardado</button></div>
		<div id="game-question" class="game-stage hidden"><div class="flex items-center justify-between gap-4"><p id="question-step" class="eyebrow"></p><span id="question-points" class="points-chip">+120 XP</span></div><h3 id="question-text" class="question-title"></h3><div id="answers" class="mt-7 grid gap-3"></div><div id="feedback" class="feedback hidden" role="status" aria-live="polite"></div><div id="hint" class="hint-box hidden" aria-live="polite"></div><div class="mt-7 flex flex-wrap justify-between gap-3"><button id="use-hint" class="button-secondary">Solicitar pista</button><button id="next-question" class="button hidden">Siguiente evidencia →</button></div></div>
		<div id="game-result" class="game-stage hidden text-center"><div class="mission-seal success">✓</div><p class="eyebrow">Caso resuelto</p><h3>¡Red asegurada, agente!</h3><p id="result-copy"></p><div class="result-score"><strong id="final-score">0</strong><span>XP OBTENIDOS</span></div><div class="badge-award"><span>⌖</span><div><small>NUEVA INSIGNIA</small><strong>Detective IP</strong></div></div><button id="play-again" class="button mt-8">Jugar de nuevo</button></div>
	</div></div>
</section>
<script>
	type Question = { prompt: string; options: readonly string[]; answer: number; hint: string; explain: string };
	const shell = document.querySelector<HTMLElement>('.game-shell')!;
	const questions: Question[] = JSON.parse(shell.dataset.questions || '[]');
	const key = 'mision-conectar-progress';
	let current = 0, score = 0, hints = 2, seconds = 720, timerId = 0, answered = false;
	const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
	const start = $('#game-start'), stage = $('#game-question'), result = $('#game-result');
	const setHidden = (el: Element, hide: boolean) => el.classList.toggle('hidden', hide);
	function loadSaved() { const saved = JSON.parse(localStorage.getItem(key) || '{}'); if (saved.completed) { $('#reset-game').classList.remove('hidden'); $('#start-game').textContent = 'Repetir misión'; } }
	function save(completed = false) { localStorage.setItem(key, JSON.stringify({ score, completed: completed ? questions.length : current, badge: completed, updatedAt: Date.now() })); }
	function update() { $('#game-score').textContent = String(score); $('#hints-count').textContent = String(hints); ($('#game-progress-bar') as HTMLElement).style.width = `${(current / questions.length) * 100}%`; }
	function render() { answered = false; const q = questions[current]; $('#question-step').textContent = `EVIDENCIA ${current + 1} DE ${questions.length}`; $('#question-text').textContent = q.prompt; setHidden($('#feedback'), true); setHidden($('#hint'), true); setHidden($('#next-question'), true); setHidden($('#use-hint'), hints === 0); const answers = $('#answers'); answers.innerHTML = ''; q.options.forEach((option, index) => { const b = document.createElement('button'); b.className = 'answer-button'; b.innerHTML = `<span>${String.fromCharCode(65 + index)}</span>${option}`; b.addEventListener('click', () => answer(index)); answers.appendChild(b); }); update(); save(); }
	function answer(index: number) { if (answered) return; answered = true; const q = questions[current]; const correct = index === q.answer; score += correct ? 120 : 25; document.querySelectorAll<HTMLButtonElement>('.answer-button').forEach((b, i) => { b.disabled = true; if (i === q.answer) b.classList.add('correct'); else if (i === index) b.classList.add('wrong'); }); const fb = $('#feedback'); fb.innerHTML = `<strong>${correct ? '✓ Evidencia validada' : '✕ Respuesta incorrecta'}</strong><p>${q.explain}</p>`; fb.classList.toggle('success', correct); setHidden(fb, false); setHidden($('#next-question'), false); update(); save(); }
	function tick() { seconds--; const min = Math.floor(seconds / 60); const sec = String(seconds % 60).padStart(2,'0'); $('#timer').textContent = `${min}:${sec}`; if (seconds <= 0) finish(); }
	function begin() { current = 0; score = 0; hints = 2; seconds = 720; setHidden(start, true); setHidden(result, true); setHidden(stage, false); clearInterval(timerId); timerId = window.setInterval(tick, 1000); render(); }
	function finish() { clearInterval(timerId); score += Math.max(0, Math.floor(seconds / 10)); save(true); setHidden(stage, true); setHidden(result, false); ($('#game-progress-bar') as HTMLElement).style.width = '100%'; $('#final-score').textContent = String(score); $('#result-copy').textContent = `Completaste ${questions.length} evidencias con ${hints} pista${hints === 1 ? '' : 's'} disponible${hints === 1 ? '' : 's'}. El dispositivo intruso quedó aislado.`; document.dispatchEvent(new CustomEvent('mission-complete', { detail: { score } })); }
	$('#start-game').addEventListener('click', begin); $('#play-again').addEventListener('click', begin);
	$('#reset-game').addEventListener('click', () => { localStorage.removeItem(key); begin(); });
	$('#use-hint').addEventListener('click', () => { if (!hints || answered) return; hints--; $('#hint').textContent = `PISTA: ${questions[current].hint}`; setHidden($('#hint'), false); if (!hints) setHidden($('#use-hint'), true); update(); });
	$('#next-question').addEventListener('click', () => { current++; current >= questions.length ? finish() : render(); });
	loadSaved(); update();
	document.addEventListener('mission-complete', ((event: CustomEvent) => { const s = String(event.detail.score); document.querySelector('#dashboard-score')!.textContent = s; document.querySelector('#dashboard-percent')!.textContent = '100%'; (document.querySelector('#dashboard-progress') as HTMLElement).style.width = '100%'; }) as EventListener);
</script>
