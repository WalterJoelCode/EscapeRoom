<button id="sound-toggle" class="sound-toggle" type="button" aria-label="Configurar sonido" title="Configurar sonido" popovertarget="sound-panel"><span aria-hidden="true">♫</span><b>SONIDO</b></button>
<div id="sound-panel" class="sound-panel" popover="auto" aria-labelledby="sound-panel-title">
  <div class="sound-panel-head"><div><small>AUDIO DE LA OPERACIÓN</small><strong id="sound-panel-title">Mezclador de sonido</strong></div><span id="sound-state-icon" aria-hidden="true">♫</span></div>
  <label class="sound-option"><span><b>Sonido general</b><small>Silencia toda la experiencia</small></span><input id="master-sound-control" type="checkbox" role="switch" /></label>
  <label class="sound-option"><span><b>Efectos del sistema</b><small>Respuestas, alertas y logros</small></span><input id="effects-sound-control" type="checkbox" role="switch" /></label>
  <label class="sound-volume"><span>Volumen de efectos <b id="effects-volume-value">70%</b></span><input id="effects-volume" type="range" min="0" max="100" step="5" /></label>
  <label class="sound-option"><span><b>Banda sonora</b><small>Suspenso tecnológico ambiental</small></span><input id="music-sound-control" type="checkbox" role="switch" /></label>
  <label class="sound-volume"><span>Volumen de música <b id="music-volume-value">35%</b></span><input id="music-volume" type="range" min="0" max="100" step="5" /></label>
  <div class="sound-track"><div><small>PISTA ACTUAL</small><strong id="sound-track-name">En espera</strong></div><button id="next-soundtrack" type="button">Cambiar pista</button></div>
</div>
<script>
  type SoundName='mission'|'success'|'error'|'complete'|'alert'|'badge'|'certificate';type Note=[number,number,number,OscillatorType,number];type Track={name:string;bpm:number;root:number;steps:number[];bass:number[];wave:OscillatorType};
  let context:AudioContext|null=null,master:GainNode|null=null,effectsGain:GainNode|null=null,musicGain:GainNode|null=null,musicTimer=0,musicStep=0,currentTrack=-1;
  let masterEnabled=localStorage.getItem('mc-sound')!=='off',effectsEnabled=localStorage.getItem('mc-effects')!=='off',musicEnabled=localStorage.getItem('mc-music')!=='off',effectsVolume=Number(localStorage.getItem('mc-effects-volume')??70)/100,musicVolume=Number(localStorage.getItem('mc-music-volume')??35)/100;
  const button=document.querySelector<HTMLButtonElement>('#sound-toggle')!,masterControl=document.querySelector<HTMLInputElement>('#master-sound-control')!,effectsControl=document.querySelector<HTMLInputElement>('#effects-sound-control')!,musicControl=document.querySelector<HTMLInputElement>('#music-sound-control')!,effectsSlider=document.querySelector<HTMLInputElement>('#effects-volume')!,musicSlider=document.querySelector<HTMLInputElement>('#music-volume')!,trackName=document.querySelector<HTMLElement>('#sound-track-name')!;
  const patterns:Record<SoundName,Note[]>={mission:[[147,.14,0,'sawtooth',.035],[294,.12,.08,'triangle',.035],[440,.18,.18,'triangle',.028]],success:[[392,.08,0,'triangle',.028],[523,.11,.055,'sine',.035],[659,.16,.12,'triangle',.028]],error:[[196,.12,0,'square',.022],[155,.18,.07,'sawtooth',.025]],complete:[[262,.09,0,'triangle',.03],[392,.11,.07,'triangle',.034],[523,.13,.15,'triangle',.036],[784,.3,.25,'sine',.028]],alert:[[220,.1,0,'square',.018],[440,.08,.04,'triangle',.025],[220,.1,.18,'square',.018],[466,.1,.22,'triangle',.025]],badge:[[523,.08,0,'sine',.03],[659,.1,.06,'triangle',.032],[784,.12,.12,'triangle',.035],[1047,.24,.21,'sine',.022]],certificate:[[330,.1,0,'triangle',.025],[494,.12,.07,'triangle',.03],[659,.15,.15,'sine',.032],[988,.3,.25,'sine',.022]]};
  const tracks:Track[]=[{name:'Firewall Pulse',bpm:124,root:55,steps:[0,7,12,15,7,19,12,10,3,10,15,19,12,7,10,15],bass:[0,0,7,0,3,3,10,7],wave:'sawtooth'},{name:'Neon Intrusion',bpm:132,root:65.41,steps:[0,12,7,19,15,12,10,7,3,15,10,22,19,15,12,7],bass:[0,7,0,10,3,10,7,12],wave:'square'},{name:'Cipher Runner',bpm:118,root:49,steps:[0,3,7,12,15,12,7,10,0,7,10,15,19,15,12,7],bass:[0,0,3,7,0,10,7,3],wave:'triangle'},{name:'Darknet Sequence',bpm:126,root:58.27,steps:[0,5,12,17,8,15,12,10,3,10,15,20,17,12,10,5],bass:[0,5,0,8,3,8,10,5],wave:'sawtooth'},{name:'Quantum Breach',bpm:138,root:73.42,steps:[0,7,14,19,12,21,19,14,2,9,14,21,19,16,14,9],bass:[0,7,2,9,0,9,7,2],wave:'square'},{name:'Zero Day Signal',bpm:116,root:46.25,steps:[0,3,10,15,12,10,7,3,5,12,15,19,15,12,10,7],bass:[0,0,5,7,3,10,7,5],wave:'triangle'},{name:'NEXO Afterdark',bpm:128,root:61.74,steps:[0,7,12,19,15,12,10,7,3,10,15,22,19,15,12,10],bass:[0,7,3,10,0,10,7,3],wave:'sawtooth'}];
  const isGameArea=()=>/\/(misiones|empareja|laboratorio)\/?$/.test(location.pathname);
  function audio(){if(!context){context=new AudioContext();const compressor=context.createDynamicsCompressor();compressor.threshold.value=-24;compressor.ratio.value=5;master=context.createGain();effectsGain=context.createGain();musicGain=context.createGain();master.gain.value=masterEnabled ? .72 : 0;effectsGain.gain.value=effectsEnabled ? effectsVolume : 0;musicGain.gain.value=musicEnabled ? musicVolume : 0;effectsGain.connect(master);musicGain.connect(master);master.connect(compressor).connect(context.destination)}if(context.state==='suspended')void context.resume();return context}
  function synth(frequency:number,duration:number,delay:number,type:OscillatorType,volume:number,target:GainNode){const ctx=audio(),start=ctx.currentTime+delay,osc=ctx.createOscillator(),gain=ctx.createGain(),filter=ctx.createBiquadFilter();osc.type=type;osc.frequency.setValueAtTime(frequency,start);filter.type='lowpass';filter.frequency.setValueAtTime(Math.min(2400,frequency*6),start);gain.gain.setValueAtTime(.0001,start);gain.gain.exponentialRampToValueAtTime(volume,start+.08);gain.gain.exponentialRampToValueAtTime(.0001,start+duration);osc.connect(filter).connect(gain).connect(target);osc.start(start);osc.stop(start+duration+.05)}
  function drum(kind:'kick'|'snare'|'hat',volume:number){const ctx=audio(),now=ctx.currentTime;if(kind==='kick'){const osc=ctx.createOscillator(),gain=ctx.createGain();osc.frequency.setValueAtTime(145,now);osc.frequency.exponentialRampToValueAtTime(42,now+.16);gain.gain.setValueAtTime(volume,now);gain.gain.exponentialRampToValueAtTime(.0001,now+.2);osc.connect(gain).connect(musicGain!);osc.start(now);osc.stop(now+.21);return}const length=kind==='snare' ? .16 : .045,buffer=ctx.createBuffer(1,Math.ceil(ctx.sampleRate*length),ctx.sampleRate),data=buffer.getChannelData(0);for(let i=0;i<data.length;i++)data[i]=(Math.random()*2-1)*(1-i/data.length);const source=ctx.createBufferSource(),filter=ctx.createBiquadFilter(),gain=ctx.createGain();source.buffer=buffer;filter.type=kind==='snare'?'bandpass':'highpass';filter.frequency.value=kind==='snare'?1700:6500;gain.gain.setValueAtTime(volume,now);gain.gain.exponentialRampToValueAtTime(.0001,now+length);source.connect(filter).connect(gain).connect(musicGain!);source.start(now)}
  function play(name:SoundName){if(!masterEnabled||!effectsEnabled)return;patterns[name].forEach(note=>synth(...note,effectsGain||audio().createGain()))}
  function scheduleMusic(){if(!masterEnabled||!musicEnabled||!isGameArea()||currentTrack<0)return;const track=tracks[currentTrack],stepTime=60000/track.bpm/2/1000,semitone=track.steps[musicStep%track.steps.length],frequency=track.root*Math.pow(2,semitone/12),bassNote=track.root/2*Math.pow(2,track.bass[Math.floor(musicStep/2)%track.bass.length]/12);drum('hat',musicStep%2===0 ? .018 : .011);if(musicStep%8===0||musicStep%8===4)drum('kick',.075);if(musicStep%8===2||musicStep%8===6)drum('snare',.032);synth(frequency,stepTime*.72,0,track.wave,.022,musicGain!);if(musicStep%2===0)synth(bassNote,stepTime*1.7,0,'square',.026,musicGain!);if(musicStep%8===0){[0,7,12].forEach((interval,index)=>synth(track.root*Math.pow(2,interval/12),stepTime*5,index*.018,'triangle',.011,musicGain!))}if(musicStep%8===7)synth(frequency*2,stepTime*.35,0,'square',.008,musicGain!);musicStep++}
  function stopMusic(){clearInterval(musicTimer);musicTimer=0}
  function startMusic(random=true){stopMusic();if(!masterEnabled||!musicEnabled||!isGameArea())return;audio();if(random||currentTrack<0){let next=Math.floor(Math.random()*tracks.length);if(tracks.length>1&&next===currentTrack)next=(next+1)%tracks.length;currentTrack=next}musicStep=0;trackName.textContent=`${tracks[currentTrack].name} · ${tracks[currentTrack].bpm} BPM`;scheduleMusic();musicTimer=window.setInterval(scheduleMusic,60000/tracks[currentTrack].bpm/2)}
  function sync(){masterControl.checked=masterEnabled;effectsControl.checked=effectsEnabled;musicControl.checked=musicEnabled;effectsSlider.value=String(Math.round(effectsVolume*100));musicSlider.value=String(Math.round(musicVolume*100));document.querySelector('#effects-volume-value')!.textContent=`${effectsSlider.value}%`;document.querySelector('#music-volume-value')!.textContent=`${musicSlider.value}%`;button.classList.toggle('muted',!masterEnabled);button.querySelector('span')!.textContent=masterEnabled?'♫':'×';document.querySelector('#sound-state-icon')!.textContent=masterEnabled?'♫':'×';if(master)master.gain.setTargetAtTime(masterEnabled ? .72 : 0,audio().currentTime,.04);if(effectsGain)effectsGain.gain.setTargetAtTime(effectsEnabled ? effectsVolume : 0,audio().currentTime,.04);if(musicGain)musicGain.gain.setTargetAtTime(musicEnabled ? musicVolume : 0,audio().currentTime,.08);if(!masterEnabled||!musicEnabled)stopMusic()}
  masterControl.addEventListener('change',()=>{masterEnabled=masterControl.checked;localStorage.setItem('mc-sound',masterEnabled?'on':'off');sync();if(masterEnabled){play('success');startMusic(false)}});effectsControl.addEventListener('change',()=>{effectsEnabled=effectsControl.checked;localStorage.setItem('mc-effects',effectsEnabled?'on':'off');sync();if(effectsEnabled)play('success')});musicControl.addEventListener('change',()=>{musicEnabled=musicControl.checked;localStorage.setItem('mc-music',musicEnabled?'on':'off');sync();if(musicEnabled)startMusic()});effectsSlider.addEventListener('input',()=>{effectsVolume=Number(effectsSlider.value)/100;localStorage.setItem('mc-effects-volume',effectsSlider.value);sync()});musicSlider.addEventListener('input',()=>{musicVolume=Number(musicSlider.value)/100;localStorage.setItem('mc-music-volume',musicSlider.value);sync()});document.querySelector('#next-soundtrack')?.addEventListener('click',()=>startMusic());
  document.addEventListener('mc-sound',((event:CustomEvent<SoundName>)=>play(event.detail)) as EventListener);document.addEventListener('click',event=>{const target=event.target as HTMLElement,answer=target.closest<HTMLButtonElement>('.answer-button');if(answer)setTimeout(()=>play(answer.classList.contains('correct')?'success':'error'),35);if(target.closest('#start-game'))play('mission');if(target.closest('#next-question'))setTimeout(()=>{if(!document.querySelector('#game-result')?.classList.contains('hidden'))play('complete')},50);if(!context&&masterEnabled&&(effectsEnabled||musicEnabled)){audio();startMusic()}});document.addEventListener('visibilitychange',()=>{if(document.hidden)stopMusic();else startMusic(false)});sync();trackName.textContent=isGameArea()?'Haz clic para iniciar':'Disponible en áreas de juego';
</script>
