<button id="sound-toggle" class="sound-toggle" type="button" aria-label="Desactivar sonidos" aria-pressed="true" title="Sonidos activados"><span aria-hidden="true">♫</span><b>SONIDO</b></button>
<script>
  type SoundName='mission'|'success'|'error'|'complete'|'alert'|'badge'|'certificate';let context:AudioContext|null=null,master:GainNode|null=null;let enabled=localStorage.getItem('mc-sound')!=='off';const button=document.querySelector<HTMLButtonElement>('#sound-toggle')!;
  const patterns:Record<SoundName,Array<[number,number,number,OscillatorType,number]>>={mission:[[147,.14,0,'sawtooth',.035],[294,.12,.08,'triangle',.035],[440,.18,.18,'triangle',.028]],success:[[392,.08,0,'triangle',.028],[523,.11,.055,'sine',.035],[659,.16,.12,'triangle',.028]],error:[[196,.12,0,'square',.022],[155,.18,.07,'sawtooth',.025]],complete:[[262,.09,0,'triangle',.03],[392,.11,.07,'triangle',.034],[523,.13,.15,'triangle',.036],[784,.3,.25,'sine',.028]],alert:[[220,.1,0,'square',.018],[440,.08,.04,'triangle',.025],[220,.1,.18,'square',.018],[466,.1,.22,'triangle',.025]],badge:[[523,.08,0,'sine',.03],[659,.1,.06,'triangle',.032],[784,.12,.12,'triangle',.035],[1047,.24,.21,'sine',.022]],certificate:[[330,.1,0,'triangle',.025],[494,.12,.07,'triangle',.03],[659,.15,.15,'sine',.032],[988,.3,.25,'sine',.022]]};
  function audio(){if(!context){context=new AudioContext();const compressor=context.createDynamicsCompressor();compressor.threshold.value=-24;compressor.knee.value=18;compressor.ratio.value=5;compressor.attack.value=.003;compressor.release.value=.2;master=context.createGain();master.gain.value=.72;master.connect(compressor).connect(context.destination)}if(context.state==='suspended')context.resume();return context}
  function tone(frequency:number,duration:number,delay:number,type:OscillatorType,volume:number){const ctx=audio(),start=ctx.currentTime+delay,osc=ctx.createOscillator(),gain=ctx.createGain(),filter=ctx.createBiquadFilter();osc.type=type;osc.frequency.setValueAtTime(frequency,start);osc.detune.setValueAtTime(-4,start);filter.type='lowpass';filter.frequency.setValueAtTime(Math.min(4200,frequency*7),start);gain.gain.setValueAtTime(.0001,start);gain.gain.exponentialRampToValueAtTime(volume,start+.012);gain.gain.exponentialRampToValueAtTime(.0001,start+duration);osc.connect(filter).connect(gain).connect(master!);osc.start(start);osc.stop(start+duration+.03)}
  function play(name:SoundName){if(!enabled)return;patterns[name].forEach(note=>tone(...note))}
  function sync(){button.setAttribute('aria-pressed',String(enabled));button.setAttribute('aria-label',enabled?'Desactivar sonidos':'Activar sonidos');button.title=enabled?'Sonidos activados':'Sonidos desactivados';button.classList.toggle('muted',!enabled);button.querySelector('span')!.textContent=enabled?'♫':'×'}
  document.addEventListener('mc-sound',((event:CustomEvent<SoundName>)=>play(event.detail)) as EventListener);document.addEventListener('click',event=>{const target=event.target as HTMLElement,answer=target.closest<HTMLButtonElement>('.answer-button');if(answer)setTimeout(()=>play(answer.classList.contains('correct')?'success':'error'),35);if(target.closest('#start-game'))play('mission');if(target.closest('#next-question'))setTimeout(()=>{if(!document.querySelector('#game-result')?.classList.contains('hidden'))play('complete')},50)});button.addEventListener('click',()=>{enabled=!enabled;localStorage.setItem('mc-sound',enabled?'on':'off');sync();if(enabled)setTimeout(()=>play('success'),30)});sync();
</script>
