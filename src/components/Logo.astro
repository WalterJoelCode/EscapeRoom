---
interface Props { size?: 'sm' | 'md'; }
const { size = 'md' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a href={base} class="flex items-center gap-3" aria-label="Misión Conectar, inicio">
	<span class:list={["grid place-items-center rounded-xl bg-cyan text-navy-deep font-black shadow-glow", size === 'sm' ? 'h-9 w-9 text-sm' : 'h-11 w-11']}>MC</span>
	<span class:list={["font-display font-bold leading-none text-white", size === 'sm' ? 'text-sm' : 'text-base']}>Misión<br/><span class="text-cyan">Conectar</span></span>
</a>
