---
interface Props { size?: 'sm' | 'md'; }
const { size = 'md' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a href={`${base}#inicio`} class="app-logo" aria-label="Misión Conectar, volver al inicio">
	<img src={`${base}logo-mark.svg`} width="48" height="48" alt="" class:list={["logo-mark", size === 'sm' ? 'logo-mark-sm' : '']} />
	<span class:list={["brand-name font-display font-bold leading-none", size === 'sm' ? 'text-sm' : 'text-base']}>Misión<br/><span>Conectar</span></span>
</a>
