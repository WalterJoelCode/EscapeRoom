<dialog id="agent-profile-dialog" class="agent-profile-dialog" aria-labelledby="agent-profile-title">
  <form id="agent-profile-form" method="dialog"><div class="profile-emblem" aria-hidden="true">MC</div><p class="eyebrow">Identificación del agente</p><h2 id="agent-profile-title">Elige tu nombre de operación</h2><p>Se mostrará en tu panel y clasificación. Puedes cambiarlo después.</p><label for="agent-name">Nombre de usuario</label><input id="agent-name" name="agentName" type="text" minlength="2" maxlength="20" autocomplete="nickname" placeholder="Ej. PacketNinja" required /><small id="agent-name-help">Entre 2 y 20 caracteres.</small><div><button id="cancel-agent-name" class="button-secondary hidden" type="button">Cancelar</button><button class="button" type="submit">Guardar identidad</button></div></form>
</dialog>
<script>
  const profileDialog=document.querySelector<HTMLDialogElement>('#agent-profile-dialog')!,profileForm=document.querySelector<HTMLFormElement>('#agent-profile-form')!,nameInput=document.querySelector<HTMLInputElement>('#agent-name')!,cancel=document.querySelector<HTMLButtonElement>('#cancel-agent-name')!;const getName=()=>localStorage.getItem('mc-agent-name')||'';const openProfile=(rename=false)=>{nameInput.value=getName();cancel.classList.toggle('hidden',!rename);profileDialog.showModal();setTimeout(()=>nameInput.focus(),50)};if(!getName())openProfile();document.addEventListener('rename-agent',()=>openProfile(true));cancel.addEventListener('click',()=>profileDialog.close());profileForm.addEventListener('submit',event=>{event.preventDefault();const name=nameInput.value.trim().replace(/\s+/g,' ');if(name.length<2){nameInput.setCustomValidity('Escribe al menos 2 caracteres.');nameInput.reportValidity();return}nameInput.setCustomValidity('');localStorage.setItem('mc-agent-name',name);profileDialog.close();document.dispatchEvent(new CustomEvent('agent-renamed',{detail:{name}}));document.dispatchEvent(new CustomEvent('mc-sound',{detail:'success'}))});profileDialog.addEventListener('cancel',event=>{if(!getName())event.preventDefault()});
</script>
