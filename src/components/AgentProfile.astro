<dialog id="agent-profile-dialog" class="agent-profile-dialog" aria-labelledby="agent-profile-title">
  <form id="agent-profile-form" method="dialog">
    <div class="profile-emblem" aria-hidden="true">MC</div>
    <p class="eyebrow">Identificación del agente</p>
    <h2 id="agent-profile-title">Crea tu identidad de misión</h2>
    <p id="agent-profile-copy">Tu nombre completo aparecerá en el certificado y solo podrá cambiarse al reiniciar el progreso. El alias sí podrás editarlo después.</p>
    <div id="full-name-field" class="profile-field">
      <label for="agent-full-name">Nombre completo</label>
      <input id="agent-full-name" name="fullName" type="text" minlength="4" maxlength="80" autocomplete="name" placeholder="Ej. Andrea López" required />
      <small>Usa el nombre que deseas mostrar en tu certificado.</small>
    </div>
    <div class="profile-field">
      <label for="agent-alias">Alias de agente</label>
      <input id="agent-alias" name="agentAlias" type="text" minlength="2" maxlength="20" autocomplete="nickname" placeholder="Ej. PacketNinja" required />
      <small>Entre 2 y 20 caracteres. Podrás cambiarlo cuando quieras.</small>
    </div>
    <div class="profile-actions"><button id="cancel-agent-name" class="button-secondary hidden" type="button">Cancelar</button><button class="button" type="submit">Guardar identidad</button></div>
  </form>
</dialog>
<script>
  const profileDialog=document.querySelector<HTMLDialogElement>('#agent-profile-dialog')!,profileForm=document.querySelector<HTMLFormElement>('#agent-profile-form')!,fullNameInput=document.querySelector<HTMLInputElement>('#agent-full-name')!,aliasInput=document.querySelector<HTMLInputElement>('#agent-alias')!,fullNameField=document.querySelector<HTMLElement>('#full-name-field')!,copy=document.querySelector<HTMLElement>('#agent-profile-copy')!,cancel=document.querySelector<HTMLButtonElement>('#cancel-agent-name')!;
  const getFullName=()=>localStorage.getItem('mc-agent-full-name')||'';const getAlias=()=>localStorage.getItem('mc-agent-alias')||localStorage.getItem('mc-agent-name')||'';
  const openProfile=(rename=false)=>{const hasIdentity=Boolean(getFullName());fullNameInput.value=getFullName();aliasInput.value=getAlias();fullNameField.hidden=rename&&hasIdentity;fullNameInput.required=!(rename&&hasIdentity);copy.textContent=rename&&hasIdentity?'Actualiza tu alias. Tu nombre completo está protegido mientras exista progreso.':'Tu nombre completo aparecerá en el certificado y solo podrá cambiarse al reiniciar el progreso. El alias sí podrás editarlo después.';cancel.classList.toggle('hidden',!hasIdentity);profileDialog.showModal();setTimeout(()=>{(rename&&hasIdentity?aliasInput:fullNameInput).focus()},50)};
  if(!getFullName()||!getAlias())openProfile();document.addEventListener('rename-agent',()=>openProfile(true));cancel.addEventListener('click',()=>profileDialog.close());
  profileForm.addEventListener('submit',event=>{event.preventDefault();const fullName=(getFullName()||fullNameInput.value).trim().replace(/\s+/g,' '),alias=aliasInput.value.trim().replace(/\s+/g,' ');if(fullName.length<4){fullNameInput.setCustomValidity('Escribe tu nombre completo.');fullNameInput.reportValidity();return}if(alias.length<2){aliasInput.setCustomValidity('Escribe un alias de al menos 2 caracteres.');aliasInput.reportValidity();return}fullNameInput.setCustomValidity('');aliasInput.setCustomValidity('');localStorage.setItem('mc-agent-full-name',fullName);localStorage.setItem('mc-agent-alias',alias);localStorage.removeItem('mc-agent-name');profileDialog.close();document.dispatchEvent(new CustomEvent('agent-renamed',{detail:{name:alias,alias,fullName}}));document.dispatchEvent(new CustomEvent('mc-sound',{detail:'success'}))});profileDialog.addEventListener('cancel',event=>{if(!getFullName()||!getAlias())event.preventDefault()});
</script>
