---
import SectionHeader from './SectionHeader.astro';
const badges=[
  {xp:500,name:'Enlace activo',path:'M12 3v6l4-2-4 8v6l-4-7 4-11Z'},
  {xp:1000,name:'Guardián LAN',path:'M4 7l8-4 8 4v5c0 5-3.4 8-8 10-4.6-2-8-5-8-10V7Zm5 5 2 2 4-4'},
  {xp:2000,name:'Núcleo seguro',path:'M12 2l3 5 6 1-4 4 1 6-6-3-6 3 1-6-4-4 6-1 3-5Z'},
  {xp:3500,name:'Arquitecto NEXO',path:'M5 18V9l7-5 7 5v9M3 20h18M9 20v-6h6v6'},
  {xp:5000,name:'Maestro de red',path:'M4 8l4 4 4-7 4 7 4-4-2 11H6L4 8Zm3 11h10'},
];
---
<section id="progreso" class="section light-section"><div class="site-container"><SectionHeader eyebrow="Panel del agente" title="Tu progreso cuenta una historia" description="Cada respuesta correcta suma experiencia. Tus logros se conservan en este navegador, sin cuentas ni datos personales." />
  <div class="mt-14 grid gap-6 lg:grid-cols-[1.25fr_.75fr]">
    <article class="dashboard-card"><div class="agent-heading"><div><p class="eyebrow">Identidad activa</p><div class="agent-name-row"><h3 id="agent-rank" class="text-2xl">Agente en entrenamiento</h3><button id="rename-agent" class="rename-agent" type="button">Renombrar</button></div><strong id="dashboard-agent-name" class="dashboard-agent-name">Agente</strong></div><div class="level-orb"><strong id="dashboard-score">0</strong><span>XP</span></div></div><div class="mt-8"><div class="mb-2 flex justify-between text-xs"><span>Misiones completadas</span><span id="dashboard-percent">0%</span></div><div class="progress-track"><i id="dashboard-progress" style="width:0%"></i><span class="progress-glint">✦</span></div></div>
      <div class="xp-badge-title"><div><p class="eyebrow">Insignias de experiencia</p><h4>Hitos del Protocolo NEXO</h4></div><small id="next-badge-copy">Siguiente insignia: 500 XP</small></div>
      <div id="xp-badge-grid" class="xp-badge-grid">{badges.map(badge=><div class="xp-badge locked" data-xp-badge={badge.xp}><div class="badge-svg"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={badge.path}></path></svg><i></i></div><strong>{badge.name}</strong><small>{badge.xp.toLocaleString('es')} XP</small></div>)}</div>
    </article>
    <article class="dashboard-card"><div class="flex items-center justify-between"><div><p class="eyebrow">Clasificación simulada</p><h3 class="mt-2 text-2xl">Ranking semanal</h3></div><span class="text-2xl">🏆</span></div><ol id="ranking-list" class="mt-6 space-y-2"></ol><p class="ranking-note">Los rivales y sus XP cambian en cada sesión. Tu posición refleja tu XP real.</p><button id="open-reset-progress" class="reset-progress-button"><span aria-hidden="true">↺</span> Reiniciar mi progreso</button></article>
  </div></div>
</section>
<dialog id="reset-progress-dialog" class="reset-progress-dialog" aria-labelledby="reset-dialog-title"><div class="reset-dialog-icon">!</div><h2 id="reset-dialog-title">¿Reiniciar todo el progreso?</h2><p>Se eliminarán tus XP, misiones completadas, rango e insignias. Tu nombre de agente se conservará.</p><div><button id="cancel-reset-progress" class="button-secondary">Conservar progreso</button><button id="confirm-reset-progress" class="danger-button">Sí, borrar progreso</button></div></dialog>
<script>
  const badgeThresholds=[500,1000,2000,3500,5000];let previousXp=Number(JSON.parse(localStorage.getItem('mision-conectar-progress-v2')||'{"totalXp":0}').totalXp||0);
  function paintProgress(payload?:{totalXp:number;completed:number}){const data=JSON.parse(localStorage.getItem('mision-conectar-progress-v2')||'{"completed":{},"totalXp":0}'),score=payload?.totalXp??Number(data.totalXp||0),completed=payload?.completed??Object.keys(data.completed||{}).length,percent=Math.round(completed/9*100),name=localStorage.getItem('mc-agent-name')||'Agente';document.querySelector('#dashboard-score')!.textContent=String(score);document.querySelector('#dashboard-agent-name')!.textContent=name;document.querySelector('#dashboard-percent')!.textContent=`${percent}%`; (document.querySelector('#dashboard-progress') as HTMLElement).style.width=`${percent}%`;document.querySelector('#agent-rank')!.textContent=completed>=9?'Maestro de red':completed>=6?'Operador avanzado':completed>=3?'Analista intermedio':completed?'Agente conectado':'Agente en entrenamiento';document.querySelectorAll<HTMLElement>('[data-xp-badge]').forEach(badge=>{const threshold=Number(badge.dataset.xpBadge),unlocked=score>=threshold;badge.classList.toggle('locked',!unlocked);if(unlocked&&previousXp<threshold){badge.classList.add('just-unlocked');document.dispatchEvent(new CustomEvent('mc-sound',{detail:'badge'}));setTimeout(()=>badge.classList.remove('just-unlocked'),1800)}});const next=badgeThresholds.find(xp=>score<xp);document.querySelector('#next-badge-copy')!.textContent=next?`Siguiente insignia: ${next.toLocaleString('es')} XP`:'Todas las insignias desbloqueadas';previousXp=score;paintRanking(score,name)}
  function getRivals(){const pool=['Luna_Router','ByteNinja','PacketFox','VLAN_Vega','PingWizard','CyberLynx'];const stored=sessionStorage.getItem('mc-rivals');if(stored)return JSON.parse(stored);const rivals=[...pool].sort(()=>Math.random()-.5).slice(0,3).map((name,i)=>({name,xp:Math.floor(700+Math.random()*3600)+(i*120)}));sessionStorage.setItem('mc-rivals',JSON.stringify(rivals));return rivals}function paintRanking(score:number,name:string){const rows=[...getRivals(),{name,xp:score,you:true}].sort((a,b)=>b.xp-a.xp);document.querySelector('#ranking-list')!.innerHTML=rows.map((row,index)=>`<li class="rank-row ${row.you?'you':''}"><span>${String(index+1).padStart(2,'0')}</span><strong>${row.name}</strong><b>${Number(row.xp).toLocaleString('es')} XP</b></li>`).join('')}
  paintProgress();document.addEventListener('mission-complete',((event:CustomEvent)=>paintProgress(event.detail)) as EventListener);document.addEventListener('agent-renamed',()=>paintProgress());document.querySelector('#rename-agent')?.addEventListener('click',()=>document.dispatchEvent(new CustomEvent('rename-agent')));const resetDialog=document.querySelector<HTMLDialogElement>('#reset-progress-dialog')!;document.querySelector('#open-reset-progress')?.addEventListener('click',()=>resetDialog.showModal());document.querySelector('#cancel-reset-progress')?.addEventListener('click',()=>resetDialog.close());resetDialog.addEventListener('click',event=>{if(event.target===resetDialog)resetDialog.close()});document.querySelector('#confirm-reset-progress')?.addEventListener('click',()=>{localStorage.removeItem('mision-conectar-progress-v2');previousXp=0;resetDialog.close();paintProgress();document.dispatchEvent(new CustomEvent('progress-reset'))});
</script>
