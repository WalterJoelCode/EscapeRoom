---
import SectionHeader from './SectionHeader.astro';
const labs=[
  {id:'ip',number:'01',tab:'IP comprometida',title:'Obtén la configuración del equipo',instruction:'Necesitas conocer dirección IPv4, máscara, gateway, DNS y si el equipo usa DHCP. Decide qué comando de Windows entrega toda esa información.',expected:'ipconfig /all',hints:['Piensa en la herramienta nativa que consulta la configuración de interfaces IP.','El comando comienza por “ip” y necesita un modificador para mostrar todos los detalles.','Ejecuta exactamente: ipconfig /all']},
  {id:'route',number:'02',tab:'Ruta del intruso',title:'Rastrea el origen de la conexión',instruction:'Necesitas enumerar cada salto entre el equipo comprometido y la IP sospechosa 185.199.110.153.',expected:'tracert 185.199.110.153',hints:['Busca una herramienta que trace la ruta de un paquete hasta un destino.','En Windows, su nombre combina “trace” y “route”; después se indica la IP.','Ejecuta exactamente: tracert 185.199.110.153']},
  {id:'sessions',number:'03',tab:'Sesiones activas',title:'Busca conexiones persistentes',instruction:'Necesitas listar conexiones activas, direcciones numéricas, estado y PID para relacionarlas con un proceso.',expected:'netstat -ano',hints:['Usa la utilidad que muestra estadísticas y conexiones de red.','Necesitas modificadores para todas las conexiones, valores numéricos y PID.','Ejecuta exactamente: netstat -ano']},
];
---
<section id="laboratorios" class="section labs-zone"><div class="site-container"><SectionHeader eyebrow="Laboratorio forense CMD" title="Interroga la red con comandos reales" description="Cada consola reproduce una parte del incidente NEXO-0213. Escribe el comando correcto, interpreta la salida y recupera evidencia del atacante." />
  <div class="cmd-workbench mt-12"><div class="lab-tabs" role="tablist" aria-label="Consolas de investigación">{labs.map((lab,index)=><button class:list={['lab-tab',index===0&&'active']} role="tab" aria-selected={index===0?'true':'false'} data-cmd-tab={lab.id}><span>{lab.number}</span>{lab.tab}<b data-cmd-check={lab.id}>○</b></button>)}</div>
    {labs.map((lab,index)=><section class:list={['cmd-case',index===0&&'active']} data-cmd-lab={lab.id} hidden={index!==0}><div class="cmd-brief"><p class="eyebrow">Evidencia {lab.number}</p><h3>{lab.title}</h3><p>{lab.instruction}</p><button class="cmd-hint-button" type="button" data-cmd-hint={lab.id} data-hints={JSON.stringify(lab.hints)}>Solicitar pista 1 de 3</button><div class="cmd-hint-panel" data-cmd-hint-panel={lab.id} hidden aria-live="polite"></div><div class="cmd-discovery" data-discovery={lab.id} aria-live="polite"><strong>ESTADO DE LA EVIDENCIA</strong><p>La evidencia aparecerá aquí cuando deduzcas y ejecutes el comando correcto.</p></div></div>
      <div class="cmd-window"><div class="cmd-titlebar"><span>C:\Windows\System32\cmd.exe</span><div><i></i><i></i><i></i></div></div><div class="cmd-output" data-cmd-output={lab.id} role="log" aria-live="polite"><p>Microsoft Windows [Versión 10.0.22631]</p><p>(c) Microsoft Corporation. Todos los derechos reservados.</p><p class="cmd-note">Consola aislada · Caso NEXO-0213 · Evidencia {lab.number}</p></div><form class="cmd-form" data-cmd-form={lab.id} data-expected={lab.expected}><label for={`cmd-${lab.id}`}>C:\NEXO\evidence&gt;</label><input id={`cmd-${lab.id}`} type="text" spellcheck="false" autocomplete="off" placeholder="Escribe el comando que has deducido" aria-label={`Comando para evidencia ${lab.number}`} /><button type="submit">Ejecutar</button></form><div class="cmd-suggestions"><button type="button" data-clear-console={lab.id}>Limpiar consola</button></div></div></section>)}
  </div>
</div></section>
<script>
  const outputs:Record<string,string[]>={ip:['Configuración IP de Windows','','Adaptador Ethernet VLAN-20:','   Dirección IPv4. . . . . . . . . . : 10.20.13.47','   Máscara de subred . . . . . . . . : 255.255.255.0','   Puerta de enlace predeterminada . . : 10.20.13.1','   Servidores DNS. . . . . . . . . . : 10.20.50.10','   DHCP habilitado. . . . . . . . . . : No'],route:['Traza a 185.199.110.153 sobre caminos de 30 saltos:','','  1    <1 ms    10.20.13.1       gateway-core','  2     2 ms    172.18.0.1       firewall-nexo','  3    18 ms    198.51.100.22    vpn-exit','  4    41 ms    185.199.110.153  edge-vps','','Traza completa.'],sessions:['Conexiones activas','','  Proto  Dirección local       Dirección remota        Estado        PID','  TCP    10.20.13.47:49722     185.199.110.153:443    ESTABLISHED   4316','  TCP    10.20.13.47:49731     10.20.50.10:445       SYN_SENT      4316','  TCP    10.20.13.47:3389      198.51.100.22:51814   ESTABLISHED   992']};
  const discoveries:Record<string,string>={ip:'¡Vaya, lo has descubierto! La IP 10.20.13.47 tiene configuración estática y está dentro de la VLAN de usuarios. El atacante evitó DHCP para conservar acceso estable.',route:'¡Ruta identificada! El tráfico pasa por una salida VPN y termina en un VPS externo. Esto explica cómo el intruso ocultó su ubicación real.',sessions:'¡Conexión confirmada! El proceso 4316 mantiene un canal HTTPS con el VPS e intenta alcanzar el servidor de archivos. Es movimiento lateral activo.'};
  const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-cmd-tab]')],panels=[...document.querySelectorAll<HTMLElement>('[data-cmd-lab]')];function activate(id:string,focusInput=false){tabs.forEach(tab=>{const active=tab.dataset.cmdTab===id;tab.classList.toggle('active',active);tab.setAttribute('aria-selected',String(active))});panels.forEach(panel=>{const active=panel.dataset.cmdLab===id;panel.hidden=!active;panel.classList.toggle('active',active)});if(focusInput)setTimeout(()=>document.querySelector<HTMLInputElement>(`[data-cmd-form="${id}"] input`)?.focus({preventScroll:true}),40)}tabs.forEach(tab=>tab.addEventListener('click',()=>activate(tab.dataset.cmdTab!,true)));
  function solved(){try{return new Set<string>(JSON.parse(localStorage.getItem('mc-cmd-evidence')||'[]'))}catch{return new Set<string>()}}function persist(done:Set<string>){localStorage.setItem('mc-cmd-evidence',JSON.stringify([...done]))}function printResult(id:string,play=true){const output=document.querySelector<HTMLElement>(`[data-cmd-output="${id}"]`)!,discovery=document.querySelector<HTMLElement>(`[data-discovery="${id}"]`)!,check=document.querySelector<HTMLElement>(`[data-cmd-check="${id}"]`)!;output.innerHTML+=outputs[id].map(line=>`<p>${line||'&nbsp;'}</p>`).join('');output.scrollTop=output.scrollHeight;discovery.classList.add('revealed');discovery.querySelector('strong')!.textContent='EVIDENCIA RECUPERADA';discovery.querySelector('p')!.textContent=discoveries[id];check.textContent='✓';check.classList.add('done');if(play)document.dispatchEvent(new CustomEvent('mc-sound',{detail:'badge'}))}
  document.querySelectorAll<HTMLFormElement>('[data-cmd-form]').forEach(form=>form.addEventListener('submit',event=>{event.preventDefault();const input=form.querySelector<HTMLInputElement>('input')!,raw=input.value,command=raw.trim().toLowerCase().replace(/\s+/g,' '),expected=form.dataset.expected!.toLowerCase(),id=form.dataset.cmdForm!,output=document.querySelector<HTMLElement>(`[data-cmd-output="${id}"]`)!,entry=document.createElement('p');entry.textContent=`C:\\NEXO\\evidence> ${raw}`;output.appendChild(entry);if(command===expected){const done=solved();if(!done.has(id)){done.add(id);persist(done);printResult(id)}else{const note=document.createElement('p');note.className='cmd-note';note.textContent='Evidencia ya registrada. Resultado disponible en el expediente.';output.appendChild(note)}}else{const error=document.createElement('p');error.className='cmd-error';error.textContent=`'${raw||'comando vacío'}' no permite obtener esta evidencia. Revisa la sintaxis indicada.`;output.appendChild(error);document.dispatchEvent(new CustomEvent('mc-sound',{detail:'error'}))}input.value='';output.scrollTop=output.scrollHeight}));
  const hintLevels:Record<string,number>={ip:0,route:0,sessions:0};document.querySelectorAll<HTMLButtonElement>('[data-cmd-hint]').forEach(button=>button.addEventListener('click',()=>{const id=button.dataset.cmdHint!,hints=JSON.parse(button.dataset.hints||'[]') as string[];hintLevels[id]=Math.min(3,hintLevels[id]+1);const level=hintLevels[id],panel=document.querySelector<HTMLElement>(`[data-cmd-hint-panel="${id}"]`)!;panel.hidden=false;panel.innerHTML=`<strong>PISTA ${level} DE 3</strong><p>${hints[level-1]}</p>`;button.textContent=level<3?`Solicitar pista ${level+1} de 3`:'Pistas agotadas';button.disabled=level===3;document.dispatchEvent(new CustomEvent('mc-sound',{detail:'alert'}))}));document.querySelectorAll<HTMLButtonElement>('[data-clear-console]').forEach(button=>button.addEventListener('click',()=>{const output=document.querySelector<HTMLElement>(`[data-cmd-output="${button.dataset.clearConsole}"]`)!;output.innerHTML='<p>Microsoft Windows [Versión 10.0.22631]</p><p class="cmd-note">Consola limpia · Caso NEXO-0213</p>'}));solved().forEach(id=>printResult(id,false));activate('ip');
</script>
