---
import SectionHeader from './SectionHeader.astro';
---
<section id="laboratorios" class="section labs-zone"><div class="site-container">
  <SectionHeader eyebrow="Zona de práctica" title="Tres laboratorios para construir la solución" description="Aquí no basta con reconocer una respuesta: conecta, empareja y ordena componentes hasta lograr una red funcional." />
  <div class="lab-workbench mt-12">
    <div class="lab-tabs" role="tablist" aria-label="Casos de laboratorio">
      <button class="lab-tab active" role="tab" aria-selected="true" data-lab-tab="topology"><span>01</span>Conecta la LAN</button>
      <button class="lab-tab" role="tab" aria-selected="false" data-lab-tab="subnet"><span>02</span>Empareja subredes</button>
      <button class="lab-tab" role="tab" aria-selected="false" data-lab-tab="cabling"><span>03</span>Ordena el cableado</button>
    </div>
    <div class="lab-case active" data-lab="topology">
      <div class="lab-case-copy"><p class="eyebrow">Caso 01 · Topología</p><h3>Restablece la ruta hacia Internet</h3><p>Selecciona un puerto de origen y después su destino. Construye la cadena <strong>Internet → Router → Switch → PC</strong>.</p><div class="lab-status" id="topology-status" aria-live="polite">0 de 3 enlaces correctos</div><button class="text-button lab-reset" data-reset-lab="topology">Reiniciar conexiones</button></div>
      <div class="topology-board" id="topology-board">
        <svg aria-hidden="true"><line data-edge="internet-router"></line><line data-edge="router-switch"></line><line data-edge="switch-pc"></line></svg>
        <button class="network-device internet" data-node="internet"><span>☁</span>Internet</button><button class="network-device router" data-node="router"><span>◎</span>Router</button><button class="network-device switch" data-node="switch"><span>▦</span>Switch</button><button class="network-device pc" data-node="pc"><span>▣</span>PC</button>
      </div>
    </div>
    <div class="lab-case" data-lab="subnet" hidden>
      <div class="lab-case-copy"><p class="eyebrow">Caso 02 · Direccionamiento</p><h3>Empareja cada host con su red</h3><p>Arrastra cada dirección hacia la subred correcta. También puedes tocar una IP y luego tocar su destino.</p><div class="lab-status" id="subnet-status" aria-live="polite">0 de 3 hosts ubicados</div><button class="text-button lab-reset" data-reset-lab="subnet">Reiniciar tablero</button></div>
      <div class="match-board"><div class="draggable-pool" id="subnet-pool"><button draggable="true" data-host="10.0.8.45" data-network="10.0.8.0/24">10.0.8.45/24</button><button draggable="true" data-host="172.16.4.70" data-network="172.16.4.64/26">172.16.4.70/26</button><button draggable="true" data-host="192.168.1.142" data-network="192.168.1.128/28">192.168.1.142/28</button></div><div class="drop-grid"><button class="network-drop" data-network="10.0.8.0/24"><small>RED /24</small>10.0.8.0</button><button class="network-drop" data-network="172.16.4.64/26"><small>RED /26</small>172.16.4.64</button><button class="network-drop" data-network="192.168.1.128/28"><small>RED /28</small>192.168.1.128</button></div></div>
    </div>
    <div class="lab-case" data-lab="cabling" hidden>
      <div class="lab-case-copy"><p class="eyebrow">Caso 03 · Cableado</p><h3>Ordena la instalación</h3><p>Arrastra los pasos hasta dejarlos en el orden profesional correcto, desde la planificación hasta la certificación.</p><div class="lab-status" id="cabling-status" aria-live="polite">Ordena los 4 pasos</div><button class="text-button lab-reset" data-reset-lab="cabling">Mezclar otra vez</button></div>
      <div class="sort-board" id="cable-sort"><div class="sort-step" draggable="true" data-order="3" tabindex="0"><b>03</b><span>Terminar conectores y patch panel</span><div><button data-move="up" aria-label="Mover terminar conectores hacia arriba">↑</button><button data-move="down" aria-label="Mover terminar conectores hacia abajo">↓</button></div></div><div class="sort-step" draggable="true" data-order="1" tabindex="0"><b>01</b><span>Relevar rutas, distancia y requisitos</span><div><button data-move="up" aria-label="Mover relevar rutas hacia arriba">↑</button><button data-move="down" aria-label="Mover relevar rutas hacia abajo">↓</button></div></div><div class="sort-step" draggable="true" data-order="4" tabindex="0"><b>04</b><span>Probar, etiquetar y documentar</span><div><button data-move="up" aria-label="Mover probar y documentar hacia arriba">↑</button><button data-move="down" aria-label="Mover probar y documentar hacia abajo">↓</button></div></div><div class="sort-step" draggable="true" data-order="2" tabindex="0"><b>02</b><span>Tender el medio respetando radios y energía</span><div><button data-move="up" aria-label="Mover tender el medio hacia arriba">↑</button><button data-move="down" aria-label="Mover tender el medio hacia abajo">↓</button></div></div></div>
    </div>
  </div>
</div></section>
<script>
  const labPanels = document.querySelectorAll<HTMLElement>('[data-lab]');
  const labTabs=[...document.querySelectorAll<HTMLButtonElement>('[data-lab-tab]')];const activateLab=(tab:HTMLButtonElement)=>{labTabs.forEach(t=>{const active=t===tab;t.classList.toggle('active',active);t.setAttribute('aria-selected',String(active));t.tabIndex=active?0:-1});labPanels.forEach(p=>{const active=p.dataset.lab===tab.dataset.labTab;p.hidden=!active;p.classList.toggle('active',active)})};labTabs.forEach((tab,index)=>{tab.addEventListener('click',()=>activateLab(tab));tab.addEventListener('keydown',event=>{if(!['ArrowLeft','ArrowRight'].includes(event.key))return;event.preventDefault();const next=event.key==='ArrowRight'?(index+1)%labTabs.length:(index-1+labTabs.length)%labTabs.length;activateLab(labTabs[next]);labTabs[next].focus()})});activateLab(labTabs[0]);
  let selectedNode:string|null=null; const correctEdges=new Set<string>();
  const updateTopology=()=>{document.querySelector('#topology-status')!.textContent=correctEdges.size===3?'✓ Red operativa · +150 XP':`${correctEdges.size} de 3 enlaces correctos`;document.querySelector('#topology-status')!.classList.toggle('success',correctEdges.size===3);document.querySelectorAll<SVGLineElement>('[data-edge]').forEach(l=>l.classList.toggle('connected',correctEdges.has(l.dataset.edge!)))};
  document.querySelectorAll<HTMLButtonElement>('[data-node]').forEach(node=>{node.setAttribute('aria-pressed','false');node.addEventListener('click',()=>{if(selectedNode===node.dataset.node){selectedNode=null;node.classList.remove('selected');node.setAttribute('aria-pressed','false');return}if(!selectedNode){selectedNode=node.dataset.node!;node.classList.add('selected');node.setAttribute('aria-pressed','true');document.querySelector('#topology-status')!.textContent=`Origen: ${node.textContent?.trim()}. Elige el destino.`;return}const origin=document.querySelector<HTMLButtonElement>(`[data-node="${selectedNode}"]`)!;const pair=[selectedNode,node.dataset.node!].sort().join('-');const map:Record<string,string>={'internet-router':'internet-router','router-switch':'router-switch','pc-switch':'switch-pc'};origin.classList.remove('selected');origin.setAttribute('aria-pressed','false');if(map[pair]){correctEdges.add(map[pair]);node.classList.add('linked');origin.classList.add('linked')}else{node.classList.add('shake');document.querySelector('#topology-status')!.textContent='Ese enlace no forma parte de la ruta. Prueba otra pareja.';setTimeout(()=>node.classList.remove('shake'),450)}selectedNode=null;if(map[pair])updateTopology()})});
  let draggedHost:HTMLElement|null=null, selectedHost:HTMLElement|null=null;
  const placeHost=(drop:HTMLElement)=>{const host=draggedHost||selectedHost;if(!host){document.querySelector('#subnet-status')!.textContent='Primero selecciona o arrastra una dirección IP.';return}if(host.dataset.network===drop.dataset.network){drop.classList.add('matched');drop.appendChild(host);host.setAttribute('draggable','false');host.classList.remove('selected');const count=document.querySelectorAll('.network-drop.matched').length;document.querySelector('#subnet-status')!.textContent=count===3?'✓ Subredes resueltas · +180 XP':`${count} de 3 hosts ubicados`;document.querySelector('#subnet-status')!.classList.toggle('success',count===3)}else{drop.classList.add('shake');document.querySelector('#subnet-status')!.textContent='La IP no pertenece a esa subred. Revisa máscara y rango.';setTimeout(()=>drop.classList.remove('shake'),450)}draggedHost=null;selectedHost=null};
  document.querySelectorAll<HTMLElement>('[data-host]').forEach(h=>{h.addEventListener('dragstart',()=>draggedHost=h);h.addEventListener('click',()=>{document.querySelectorAll('[data-host]').forEach(x=>x.classList.remove('selected'));selectedHost=h;h.classList.add('selected')})});document.querySelectorAll<HTMLElement>('.network-drop').forEach(d=>{d.addEventListener('dragover',e=>e.preventDefault());d.addEventListener('drop',()=>placeHost(d));d.addEventListener('click',()=>placeHost(d))});
  let draggedStep:HTMLElement|null=null;const sort=document.querySelector<HTMLElement>('#cable-sort')!;const checkSort=()=>{const ok=[...sort.children].every((el,i)=>Number((el as HTMLElement).dataset.order)===i+1);document.querySelector('#cabling-status')!.textContent=ok?'✓ Instalación certificada · +200 XP':'Sigue ordenando los 4 pasos';document.querySelector('#cabling-status')!.classList.toggle('success',ok);sort.classList.toggle('complete',ok)};sort.querySelectorAll<HTMLElement>('.sort-step').forEach(step=>{step.addEventListener('dragstart',()=>{draggedStep=step;step.classList.add('dragging')});step.addEventListener('dragend',()=>step.classList.remove('dragging'));step.addEventListener('dragover',e=>e.preventDefault());step.addEventListener('drop',(event)=>{event.preventDefault();if(draggedStep&&draggedStep!==step){const rect=step.getBoundingClientRect();sort.insertBefore(draggedStep,event.clientY>rect.top+rect.height/2?step.nextSibling:step);checkSort()}});step.querySelectorAll<HTMLButtonElement>('[data-move]').forEach(control=>control.addEventListener('click',()=>{if(control.dataset.move==='up'&&step.previousElementSibling)sort.insertBefore(step,step.previousElementSibling);if(control.dataset.move==='down'&&step.nextElementSibling)sort.insertBefore(step.nextElementSibling,step);checkSort();step.focus()}))});
  document.querySelectorAll<HTMLButtonElement>('[data-reset-lab]').forEach(b=>b.addEventListener('click',()=>{if(b.dataset.resetLab==='topology'){correctEdges.clear();selectedNode=null;document.querySelectorAll<HTMLButtonElement>('.network-device').forEach(n=>{n.classList.remove('selected','linked');n.setAttribute('aria-pressed','false')});updateTopology()}if(b.dataset.resetLab==='subnet'){const pool=document.querySelector('#subnet-pool')!;document.querySelectorAll<HTMLElement>('[data-host]').forEach(h=>{pool.appendChild(h);h.setAttribute('draggable','true');h.classList.remove('selected')});document.querySelectorAll('.network-drop').forEach(d=>d.classList.remove('matched'));document.querySelector('#subnet-status')!.classList.remove('success');document.querySelector('#subnet-status')!.textContent='0 de 3 hosts ubicados'}if(b.dataset.resetLab==='cabling'){[...sort.children].sort(()=>Math.random()-.5).forEach(x=>sort.appendChild(x));sort.classList.remove('complete');document.querySelector('#cabling-status')!.classList.remove('success');document.querySelector('#cabling-status')!.textContent='Ordena los 4 pasos'}}));
</script>
