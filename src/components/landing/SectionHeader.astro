---
interface Props { eyebrow: string; title: string; description?: string; align?: 'left' | 'center'; }
const { eyebrow, title, description, align = 'center' } = Astro.props;
---
<div class:list={['section-heading', align === 'left' ? 'text-left mx-0' : 'text-center']}>
	<p class="eyebrow">{eyebrow}</p><h2>{title}</h2>{description && <p class="section-description">{description}</p>}
</div>
