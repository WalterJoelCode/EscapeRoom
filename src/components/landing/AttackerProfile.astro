---
import SectionHeader from './SectionHeader.astro';
---
<section id="atacante" class="section attacker-zone"><div class="site-container"><SectionHeader eyebrow="Expediente NEXO-0213" title="Reconstruye la identidad del atacante" description="Cada misión completada desbloquea evidencia del mismo incidente. Las conclusiones aparecen solo cuando has reunido suficientes señales." />
  <div class="attacker-dossier mt-12"><div class="attacker-portrait"><svg viewBox="0 0 220 250" aria-hidden="true"><path d="M52 211c5-51 24-76 58-76s53 25 58 76"/><circle cx="110" cy="88" r="43"/><path d="M76 76c8-37 59-37 68 0M88 94h10m24 0h10M100 116h20"/><path class="scan-line" d="M35 128h150"/></svg><div id="attacker-confidence" class="confidence-ring"><strong>0%</strong><span>confianza</span></div></div>
    <div class="dossier-data"><div class="dossier-head"><div><small>OBJETIVO PRIORITARIO</small><h3 id="attacker-alias">IDENTIDAD DESCONOCIDA</h3></div><span id="case-progress">0 / 9 EVIDENCIAS</span></div><div class="clue-grid"><article data-clue="2"><small>ORIGEN DE ACCESO</small><strong>•••.•••.•••.•••</strong><p>Completa 2 misiones</p></article><article data-clue="4"><small>TÉCNICA INICIAL</small><strong>████████████</strong><p>Completa 4 misiones</p></article><article data-clue="6"><small>INFRAESTRUCTURA</small><strong>████████████</strong><p>Completa 6 misiones</p></article><article data-clue="8"><small>ALIAS OPERATIVO</small><strong>████████</strong><p>Completa 8 misiones</p></article></div><div id="attacker-latest" class="latest-evidence" aria-live="polite"><span>ÚLTIMA EVIDENCIA</span><p>Aún no hay evidencia suficiente. Comienza la Misión 01.</p></div></div></div>
</div></section>
<script>
  const revelations=[{at:0,latest:'Aún no hay evidencia suficiente. Comienza la Misión 01.'},{at:2,field:0,value:'185.199.110.153',latest:'La sesión remota se originó en una IP vinculada a infraestructura alquilada.'},{at:4,field:1,value:'Credencial filtrada',latest:'No hubo explotación inicial: el atacante utilizó una contraseña válida expuesta.'},{at:6,field:2,value:'VPS + túnel cifrado',latest:'Los saltos apuntan a un VPS y a un túnel usado para ocultar el origen real.'},{at:8,field:3,value:'NULL-RAVEN',latest:'Un alias aparece repetido en los metadatos recuperados: NULL-RAVEN.'},{at:9,latest:'Caso reconstruido: NULL-RAVEN aprovechó una credencial filtrada y una red sin segmentación suficiente.'}];
  function paintAttacker(){const data=JSON.parse(localStorage.getItem('mision-conectar-progress-v2')||'{"completed":{}}'),completed=Object.keys(data.completed||{}).length,confidence=Math.round(completed/9*100),cards=[...document.querySelectorAll<HTMLElement>('[data-clue]')];document.querySelector('#case-progress')!.textContent=`${completed} / 9 EVIDENCIAS`;document.querySelector('#attacker-confidence strong')!.textContent=`${confidence}%`;document.querySelector<HTMLElement>('#attacker-confidence')!.style.setProperty('--confidence',`${confidence*3.6}deg`);cards.forEach((card,index)=>{const reveal=revelations.find(item=>item.field===index)!;card.classList.toggle('revealed',completed>=reveal.at);card.querySelector('strong')!.textContent=completed>=reveal.at?reveal.value!:(index===0?'•••.•••.•••.•••':'████████████');card.querySelector('p')!.textContent=completed>=reveal.at?'Evidencia confirmada':`Completa ${reveal.at} misiones`});const latest=[...revelations].reverse().find(item=>completed>=item.at)!;document.querySelector('#attacker-latest p')!.textContent=latest.latest;document.querySelector('#attacker-alias')!.textContent=completed>=8?'NULL-RAVEN':'IDENTIDAD DESCONOCIDA';document.querySelector('.attacker-portrait')?.classList.toggle('identified',completed>=9)}paintAttacker();document.addEventListener('mission-complete',paintAttacker);document.addEventListener('progress-reset',paintAttacker);
</script>
