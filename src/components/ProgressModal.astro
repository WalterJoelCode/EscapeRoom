<button id="progress-fab" class="progress-fab" aria-haspopup="dialog" aria-controls="progress-modal"><span>↗</span><b>Mi progreso</b></button>
<dialog id="progress-modal" class="progress-modal" aria-labelledby="progress-modal-title"><div class="progress-modal-head"><div><p class="eyebrow">Resumen del agente</p><h2 id="progress-modal-title">Mi progreso</h2></div><button id="progress-modal-close" class="icon-button" aria-label="Cerrar resumen">×</button></div><div class="progress-modal-body"><div class="modal-level"><div><small id="modal-agent-name">AGENTE</small><strong id="modal-rank">Agente en entrenamiento</strong></div><div class="level-orb"><strong id="modal-xp">0</strong><span>XP</span></div></div><div><div class="modal-progress-label"><span>Misiones completadas</span><b id="modal-progress-copy">0 / 9</b></div><div class="progress-track"><i id="modal-progress-bar" style="width:0%"></i></div></div><div id="modal-xp-badges" class="modal-xp-badges">{[500,1000,2000,3500,5000].map(xp=><span data-modal-badge={xp} title={`${xp} XP`}>◆<small>{xp>=1000?`${xp/1000}K`:xp}</small></span>)}</div><div class="modal-actions"><button id="modal-rename-agent" class="button-secondary" type="button">Cambiar alias</button><a id="view-full-progress" class="button" href={`${import.meta.env.BASE_URL}#progreso`}>Ver panel completo</a></div></div></dialog>
<script>
  const progressModal=document.querySelector<HTMLDialogElement>('#progress-modal')!,progressFab=document.querySelector<HTMLButtonElement>('#progress-fab')!;const paintModal=()=>{const data=JSON.parse(localStorage.getItem('mision-conectar-progress-v2')||'{"completed":{},"totalXp":0}'),completed=Object.keys(data.completed||{}).length,xp=Number(data.totalXp||0),name=localStorage.getItem('mc-agent-alias')||localStorage.getItem('mc-agent-name')||'Agente';document.querySelector('#modal-agent-name')!.textContent=name.toUpperCase();document.querySelector('#modal-xp')!.textContent=String(xp);document.querySelector('#modal-progress-copy')!.textContent=`${completed} / 9`;document.querySelector('#modal-rank')!.textContent=completed>=9?'Maestro de red':completed>=6?'Operador avanzado':completed>=3?'Analista intermedio':completed?'Agente conectado':'Agente en entrenamiento';(document.querySelector('#modal-progress-bar') as HTMLElement).style.width=`${Math.round(completed/9*100)}%`;document.querySelectorAll<HTMLElement>('[data-modal-badge]').forEach(b=>b.classList.toggle('locked',xp<Number(b.dataset.modalBadge)))};progressFab.addEventListener('click',()=>{paintModal();progressModal.showModal()});document.querySelector('#progress-modal-close')?.addEventListener('click',()=>progressModal.close());document.querySelector('#view-full-progress')?.addEventListener('click',()=>progressModal.close());document.querySelector('#modal-rename-agent')?.addEventListener('click',()=>{progressModal.close();document.dispatchEvent(new CustomEvent('rename-agent'))});progressModal.addEventListener('click',event=>{if(event.target===progressModal)progressModal.close()});document.addEventListener('mission-complete',paintModal);document.addEventListener('progress-reset',paintModal);document.addEventListener('agent-renamed',paintModal);paintModal();
</script>
