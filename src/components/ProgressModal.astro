---
const base = import.meta.env.BASE_URL;
---
<button id="progress-fab" class="progress-fab" aria-haspopup="dialog" aria-controls="progress-modal"><span>↗</span><b>Mi progreso</b></button>
<dialog id="progress-modal" class="progress-modal" aria-labelledby="progress-modal-title">
  <div class="progress-modal-head"><div><p class="eyebrow">Resumen del agente</p><h2 id="progress-modal-title">Mi progreso</h2></div><button id="progress-modal-close" class="icon-button" aria-label="Cerrar resumen">×</button></div>
  <div class="progress-modal-body">
    <div class="modal-level"><div><small id="modal-agent-name">AGENTE</small><strong id="modal-rank">Agente en entrenamiento</strong></div><div class="level-orb"><strong id="modal-xp">0</strong><span>XP</span></div></div>
    <div><div class="modal-progress-label"><span>Misiones completadas</span><b id="modal-progress-copy">0 / 9</b></div><div class="progress-track"><i id="modal-progress-bar" style="width:0%"></i></div></div>
    <div class="modal-attacker-summary"><div><small>IDENTIDAD DEL ATACANTE</small><strong id="modal-attacker-name">Identidad desconocida</strong></div><span id="modal-attacker-confidence">0% confianza</span><p id="modal-attacker-copy">Completa misiones para recuperar evidencia del caso NEXO-0213.</p></div>
    <div id="modal-xp-badges" class="modal-xp-badges">{[500,1000,2000,3500,5000].map(xp=><span data-modal-badge={xp} title={`${xp} XP`}>◆<small>{xp>=1000?`${xp/1000}K`:xp}</small></span>)}</div>
    <div class="modal-utility-actions"><button id="modal-rename-agent" class="button-secondary" type="button">Cambiar alias</button><button id="share-achievements" class="button-secondary" type="button"><span aria-hidden="true">↗</span> Compartir mis logros</button></div>
    <p id="share-achievements-status" class="share-achievements-status" role="status" aria-live="polite"></p>
    <div class="modal-actions"><a id="view-all-missions" class="button-secondary" href={`${base}#misiones`}>Ver todas las misiones</a><a id="view-attacker-info" class="button" href={`${base}#atacante`}>Ver información del atacante</a></div>
  </div>
</dialog>
<script>
  const progressModal=document.querySelector<HTMLDialogElement>('#progress-modal')!,progressFab=document.querySelector<HTMLButtonElement>('#progress-fab')!;
  const paintModal=()=>{const data=JSON.parse(localStorage.getItem('mision-conectar-progress-v2')||'{"completed":{},"totalXp":0}'),completed=Object.keys(data.completed||{}).length,xp=Number(data.totalXp||0),name=localStorage.getItem('mc-agent-alias')||localStorage.getItem('mc-agent-name')||'Agente',confidence=Math.round(completed/9*100),attacker=completed>=8?'NØD3-13':'Identidad desconocida';document.querySelector('#modal-agent-name')!.textContent=name.toUpperCase();document.querySelector('#modal-xp')!.textContent=String(xp);document.querySelector('#modal-progress-copy')!.textContent=`${completed} / 9`;document.querySelector('#modal-rank')!.textContent=completed>=9?'Maestro de red':completed>=6?'Operador avanzado':completed>=3?'Analista intermedio':completed?'Agente conectado':'Agente en entrenamiento';document.querySelector('#modal-attacker-name')!.textContent=attacker;document.querySelector('#modal-attacker-confidence')!.textContent=`${confidence}% confianza`;document.querySelector('#modal-attacker-copy')!.textContent=completed?`${completed} ${completed===1?'evidencia recuperada':'evidencias recuperadas'} del caso NEXO-0213.`:'Completa misiones para recuperar evidencia del caso NEXO-0213.';(document.querySelector('#modal-progress-bar') as HTMLElement).style.width=`${confidence}%`;document.querySelectorAll<HTMLElement>('[data-modal-badge]').forEach(b=>b.classList.toggle('locked',xp<Number(b.dataset.modalBadge)))};
  const createAchievementImage=()=>new Promise<Blob>((resolve,reject)=>{const data=JSON.parse(localStorage.getItem('mision-conectar-progress-v2')||'{"completed":{},"totalXp":0}'),completed=Object.keys(data.completed||{}).length,xp=Number(data.totalXp||0),alias=localStorage.getItem('mc-agent-alias')||localStorage.getItem('mc-agent-name')||'Agente',rank=completed>=9?'Maestro de red':completed>=6?'Operador avanzado':completed>=3?'Analista intermedio':completed?'Agente conectado':'Agente en entrenamiento',confidence=Math.round(completed/9*100),badges=[500,1000,2000,3500,5000].filter(value=>xp>=value).length,canvas=document.createElement('canvas');canvas.width=1200;canvas.height=900;const ctx=canvas.getContext('2d')!,box=(x:number,y:number,w:number,h:number,r:number,color:string)=>{ctx.fillStyle=color;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()},gradient=ctx.createLinearGradient(0,0,1200,900);gradient.addColorStop(0,'#071426');gradient.addColorStop(.55,'#0a2037');gradient.addColorStop(1,'#063149');ctx.fillStyle=gradient;ctx.fillRect(0,0,1200,900);ctx.strokeStyle='rgba(67,215,255,.075)';for(let x=0;x<1200;x+=48){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,900);ctx.stroke()}for(let y=0;y<900;y+=48){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(1200,y);ctx.stroke()}box(70,65,1060,770,28,'rgba(67,215,255,.08)');ctx.fillStyle='#43d7ff';ctx.font='800 24px Manrope';ctx.fillText('MISIÓN CONECTAR · CASO NEXO-0213',115,125);ctx.fillStyle='#edf8ff';ctx.font='700 62px Space Grotesk';ctx.fillText(alias.slice(0,25),115,215);ctx.fillStyle='#8da7ba';ctx.font='600 25px Manrope';ctx.fillText(rank,118,260);[{label:'EXPERIENCIA',value:`${xp} XP`,color:'#43d7ff'},{label:'MISIONES',value:`${completed} / 9`,color:'#3ee6a2'},{label:'INSIGNIAS',value:`${badges} / 5`,color:'#fbbf24'}].forEach((card,index)=>{const x=115+index*325;box(x,320,290,150,18,'rgba(5,16,30,.72)');ctx.fillStyle=card.color;ctx.font='800 18px Manrope';ctx.fillText(card.label,x+24,360);ctx.fillStyle='#edf8ff';ctx.font='700 42px Space Grotesk';ctx.fillText(card.value,x+24,425)});ctx.fillStyle='#edf8ff';ctx.font='700 30px Space Grotesk';ctx.fillText('Identidad del atacante',115,555);ctx.fillStyle='#8da7ba';ctx.font='500 22px Manrope';ctx.fillText(completed>=8?'Alias operativo identificado':'Investigación en curso',115,595);box(115,630,920,18,9,'rgba(127,155,177,.18)');const bar=ctx.createLinearGradient(115,0,1035,0);bar.addColorStop(0,'#43d7ff');bar.addColorStop(1,'#3ee6a2');box(115,630,Math.max(18,920*confidence/100),18,9,bar as unknown as string);ctx.fillStyle='#edf8ff';ctx.font='700 34px Space Grotesk';ctx.fillText(`${confidence}% de confianza`,115,710);ctx.fillStyle='#8da7ba';ctx.font='500 20px Manrope';ctx.fillText('Progreso local · Continúa reconstruyendo la red',115,785);canvas.toBlob(blob=>blob?resolve(blob):reject(new Error('image')),'image/png')});
  document.querySelector<HTMLButtonElement>('#share-achievements')?.addEventListener('click',async()=>{const button=document.querySelector<HTMLButtonElement>('#share-achievements')!,status=document.querySelector<HTMLElement>('#share-achievements-status')!;button.disabled=true;status.textContent='Preparando imagen…';try{const blob=await createAchievementImage(),file=new File([blob],'mis-logros-mision-conectar.png',{type:'image/png'});if(navigator.share&&navigator.canShare?.({files:[file]})){await navigator.share({title:'Mis logros en Misión Conectar',text:'Este es mi avance en el caso NEXO-0213.',files:[file]});status.textContent='Imagen compartida.'}else{const url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download=file.name;link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);status.textContent='Imagen descargada. Ya puedes compartirla.'}}catch(error){status.textContent=(error as Error).name==='AbortError'?'Compartir cancelado.':'No fue posible crear la imagen.'}finally{button.disabled=false}});
  progressFab.addEventListener('click',()=>{paintModal();progressModal.showModal()});document.querySelector('#progress-modal-close')?.addEventListener('click',()=>progressModal.close());document.querySelectorAll('#view-all-missions,#view-attacker-info').forEach(link=>link.addEventListener('click',()=>progressModal.close()));document.querySelector('#modal-rename-agent')?.addEventListener('click',()=>{progressModal.close();document.dispatchEvent(new CustomEvent('rename-agent'))});progressModal.addEventListener('click',event=>{if(event.target===progressModal)progressModal.close()});document.addEventListener('mission-complete',paintModal);document.addEventListener('progress-reset',paintModal);document.addEventListener('agent-renamed',paintModal);paintModal();
</script>
