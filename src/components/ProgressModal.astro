<button id="progress-fab" class="progress-fab" aria-haspopup="dialog" aria-controls="progress-modal"><span>↗</span><b>Mi progreso</b></button>
<dialog id="progress-modal" class="progress-modal" aria-labelledby="progress-modal-title">
  <div class="progress-modal-head"><div><p class="eyebrow">Resumen del agente</p><h2 id="progress-modal-title">Mi progreso</h2></div><button id="progress-modal-close" class="icon-button" aria-label="Cerrar resumen">×</button></div>
  <div class="progress-modal-body"><div class="modal-level"><div><small>RANGO ACTUAL</small><strong id="modal-rank">Agente en entrenamiento</strong></div><div class="level-orb"><strong id="modal-xp">0</strong><span>XP</span></div></div><div><div class="modal-progress-label"><span>Misiones completadas</span><b id="modal-progress-copy">0 / 6</b></div><div class="progress-track"><i id="modal-progress-bar" style="width:0%"></i></div></div><div class="modal-badges"><div><span>⚡</span><small>Primer enlace</small></div><div><span>⌖</span><small>Detective IP</small></div><div><span>◎</span><small>Triple inicial</small></div><div><span>◆</span><small>Operador</small></div></div><a class="button" href={`${import.meta.env.BASE_URL}#progreso`}>Ver panel completo</a></div>
</dialog>
<script>
  const progressModal=document.querySelector<HTMLDialogElement>('#progress-modal')!;const progressFab=document.querySelector<HTMLButtonElement>('#progress-fab')!;const paintModal=()=>{const data=JSON.parse(localStorage.getItem('mision-conectar-progress-v2')||'{"completed":{},"totalXp":0}');const completed=Object.keys(data.completed||{}).length;const xp=Number(data.totalXp||0);document.querySelector('#modal-xp')!.textContent=String(xp);document.querySelector('#modal-progress-copy')!.textContent=`${completed} / 6`;document.querySelector('#modal-rank')!.textContent=completed>=6?'Operador de red':completed>=3?'Analista intermedio':completed?'Agente conectado':'Agente en entrenamiento';(document.querySelector('#modal-progress-bar') as HTMLElement).style.width=`${Math.round(completed/6*100)}%`;document.querySelectorAll('.modal-badges>div').forEach((b,i)=>b.classList.toggle('locked',i===0?completed<1:i===1?!data.completed?.['02']:i===2?completed<3:completed<6))};progressFab.addEventListener('click',()=>{paintModal();progressModal.showModal()});document.querySelector('#progress-modal-close')?.addEventListener('click',()=>progressModal.close());progressModal.addEventListener('click',event=>{if(event.target===progressModal)progressModal.close()});document.addEventListener('mission-complete',paintModal);document.addEventListener('progress-reset',paintModal);paintModal();
</script>
