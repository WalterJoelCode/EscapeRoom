<dialog id="story-intro" class="story-intro" aria-labelledby="story-intro-title">
  <div class="intro-scan" aria-hidden="true"></div><button id="skip-intro" class="intro-skip" type="button">Saltar transmisión</button>
  <div class="story-scenes">
    <section class="story-scene active" data-story-scene="0"><div class="story-vector breach-vector" aria-hidden="true"><svg viewBox="0 0 320 150"><path d="M25 75h70m130 0h70M95 75l35-42h60l35 42-35 42h-60L95 75Z"/><circle cx="25" cy="75" r="9"/><circle cx="295" cy="75" r="9"/><path class="danger-path" d="m151 48 22 25-18 9 14 23"/></svg></div><p class="eyebrow">02:13:08 · Alerta crítica</p><h2 id="story-intro-title">Alguien entró en la red.</h2><p>Una credencial expuesta abrió una sesión remota en el servidor de acceso. En segundos, el intruso comenzó a reconocer nuestros sectores.</p></section>
    <section class="story-scene" data-story-scene="1" hidden><div class="story-vector packet-vector" aria-hidden="true"><svg viewBox="0 0 320 150"><path d="M30 30h75v90H30zM215 30h75v90h-75zM105 55h110M105 95h110"/><circle cx="130" cy="55" r="7"/><circle class="hostile-packet" cx="175" cy="95" r="8"/><path d="m168 88 14 14m0-14-14 14"/></svg></div><p class="eyebrow">02:16:41 · Movimiento lateral</p><h2>El ataque se propagó.</h2><p>La IP comprometida saltó entre VLAN, consultó rutas y buscó servicios sin protección. Aulas, empresas y nodos públicos comenzaron a quedar aislados.</p></section>
    <section class="story-scene" data-story-scene="2" hidden><div class="story-vector blackout-vector" aria-hidden="true"><svg viewBox="0 0 320 150"><circle cx="160" cy="75" r="20"/><circle cx="55" cy="35" r="11"/><circle cx="265" cy="35" r="11"/><circle cx="55" cy="115" r="11"/><circle cx="265" cy="115" r="11"/><path d="M72 42l68 25m40 0 68-25M72 108l68-25m40 0 68 25"/><path class="danger-path" d="m151 57 19 18-13 8 11 15"/></svg></div><p class="eyebrow">02:21:03 · Red degradada</p><h2>Dejó pistas, pero ocultó su identidad.</h2><p>Conservamos fragmentos de configuración, saltos de red y conexiones activas. Cada misión recuperará una evidencia del mismo incidente.</p></section>
    <section class="story-scene" data-story-scene="3" hidden><div class="story-vector agent-vector" aria-hidden="true"><svg viewBox="0 0 320 150"><path d="M70 112V78l45-26 45 26v34M160 112V63l38-23 52 30v42"/><circle cx="115" cy="40" r="12"/><path d="M97 40h36M222 53l8 9 17-20"/></svg></div><p class="eyebrow">Protocolo NEXO · Tu operación</p><h2>Recupera la red. Identifica al atacante.</h2><p>Completa nueve misiones y ejecuta comandos de investigación. Cada hallazgo revelará origen, técnica, infraestructura y finalmente la identidad del intruso.</p><div class="intro-objective"><span>CASO BASE · NEXO-0213</span><strong>Contener el ataque y reconstruir la evidencia</strong><small>Todo el progreso se guarda únicamente en este dispositivo.</small></div></section>
  </div>
  <div class="story-controls"><div class="story-dots" aria-label="Progreso de la historia">{[0,1,2,3].map(i=><button data-story-dot={i} class:list={[i===0&&'active']} aria-label={`Escena ${i+1}`}></button>)}</div><button id="story-next" class="button" type="button">Continuar investigación →</button></div>
</dialog>
<script>
  const intro=document.querySelector<HTMLDialogElement>('#story-intro')!,scenes=[...document.querySelectorAll<HTMLElement>('[data-story-scene]')],dots=[...document.querySelectorAll<HTMLButtonElement>('[data-story-dot]')],next=document.querySelector<HTMLButtonElement>('#story-next')!;let scene=0,storyTimer=0;
  function showScene(index:number,withSound=true){scene=Math.max(0,Math.min(index,scenes.length-1));scenes.forEach((item,i)=>{item.hidden=i!==scene;item.classList.toggle('active',i===scene)});dots.forEach((dot,i)=>dot.classList.toggle('active',i===scene));next.textContent=scene===scenes.length-1?'Entrar al centro de operaciones →':'Siguiente transmisión →';if(withSound)document.dispatchEvent(new CustomEvent('mc-sound',{detail:scene===3?'mission':'alert'}));clearTimeout(storyTimer);if(scene<scenes.length-1)storyTimer=window.setTimeout(()=>showScene(scene+1),4200)}
  const openIntro=()=>{if(!intro.open)intro.showModal();showScene(0,false);setTimeout(()=>document.dispatchEvent(new CustomEvent('mc-sound',{detail:'alert'})),150)};const closeIntro=()=>{clearTimeout(storyTimer);intro.close();sessionStorage.setItem('mc-intro-seen','true');document.dispatchEvent(new CustomEvent('mc-sound',{detail:'success'}))};if(!sessionStorage.getItem('mc-intro-seen')&&localStorage.getItem('mc-agent-full-name'))openIntro();document.addEventListener('agent-renamed',()=>{if(!sessionStorage.getItem('mc-intro-seen'))openIntro()});document.addEventListener('replay-intro',openIntro);dots.forEach((dot,i)=>dot.addEventListener('click',()=>showScene(i)));next.addEventListener('click',()=>scene===scenes.length-1?closeIntro():showScene(scene+1));document.querySelector('#skip-intro')?.addEventListener('click',closeIntro);intro.addEventListener('cancel',event=>{event.preventDefault();closeIntro()});
</script>
